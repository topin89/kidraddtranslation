#. comic310 panel p4
#. slot: right bubble
#. images: raddstand.gif, kobastand2.gif
#: kidradd/comic310.htm:245
msgctxt "comic310#p4.2"
msgid "Oh, shut up. My version's cooler."
msgstr ""

#. comic311 panel title
#. slot: background color and image
#: kidradd/comic311.htm:36
msgctxt "comic311#title.1"
msgid "\"GONNA FIND YA\""
msgstr ""

#. comic311 panel p1
#. slot: left bubble
#. images: raddright.gif, kobablink2.gif
#: kidradd/comic311.htm:77
msgctxt "comic311#p1.1"
msgid "Well, however you got here, you'd better not try anything funny."
msgstr ""

#. comic311 panel p1
#. slot: right bubble
#. images: raddright.gif, kobablink2.gif
#: kidradd/comic311.htm:81
msgctxt "comic311#p1.2"
msgid "\"Funny?\" I do not understand. Do you mean something like..."
msgstr ""

#. comic311 panel p2
#. slot: right bubble
#. images: kobapunch.gif
#: kidradd/comic311.htm:138
msgctxt "comic311#p2.1"
msgid "...<b>This?</b>"
msgstr ""

#. comic311 panel p3
#. slot: left bubble
#. images: raddbutt.gif, kobaoops.gif
#: kidradd/comic311.htm:187
msgctxt "comic311#p3.1"
msgid "Uh, I'm over here. Like, two feet to your right."
msgstr ""

#. comic311 panel p4
#. slot: left bubble
#. images: kobacry2.gif, raddstare.gif
#: kidradd/comic311.htm:239
msgctxt "comic311#p4.1"
msgid "Curse you, third dimension! Must you always mock me???"
msgstr ""

#. comic311 panel p4
#. slot: right bubble
#. images: kobacry2.gif, raddstare.gif
#: kidradd/comic311.htm:243
msgctxt "comic311#p4.2"
msgid "Dude, how do you even put on your pants?"
msgstr ""

#. comic312 panel title
#. slot: background color and image
#: kidradd/comic312.htm:36
msgctxt "comic312#title.1"
msgid "\"PROMISES, PROMISES\""
msgstr ""

#. comic312 panel p1
#. slot: left bubble
#. images: kobabeat2.gif, raddstare.gif
#: kidradd/comic312.htm:77
msgctxt "comic312#p1.1"
msgid "No use denying it - I am beaten. In my current state, there's no way I can beat you."
msgstr ""

#. comic312 panel p1
#. slot: right bubble
#. images: kobabeat2.gif, raddstare.gif
#: kidradd/comic312.htm:81
msgctxt "comic312#p1.2"
msgid "Damn straight."
msgstr ""

#. comic312 panel p2
#. slot: right bubble
#. images: kobayes.gif
#: kidradd/comic312.htm:138
msgctxt "comic312#p2.1"
msgid "But the Discount Ninja will never give up! I shall conquer the challenge of the third dimension, and someday return to give you a proper duel. That is my solemn oath!"
msgstr ""

#. comic312 panel p3
#. slot: right bubble
#. images: kobaoh2.gif, raddstare.gif
#: kidradd/comic312.htm:191
msgctxt "comic312#p3.1"
msgid "Well maybe, assuming I don't decide to just kill you now."
msgstr ""

#. comic312 panel p4
#. slot: left bubble
#. images: kobacry.gif, raddblink2.gif
#: kidradd/comic312.htm:239
msgctxt "comic312#p4.1"
msgid "You <b>wouldn't!</b>"
msgstr ""

#. comic312 panel p4
#. slot: right bubble
#. images: kobacry.gif, raddblink2.gif
#: kidradd/comic312.htm:243
msgctxt "comic312#p4.2"
msgid "You're right. But I had ya going, didn't I?"
msgstr ""

#. comic313 panel title
#. slot: background color and image
#: kidradd/comic313.htm:48
msgctxt "comic313#title.1"
msgid "\"ADIEU\""
msgstr ""

#. comic313 panel p1
#. slot: left bubble
#. images: kobablink.gif, raddsigh2.gif
#: kidradd/comic313.htm:89
