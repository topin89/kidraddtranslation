#. comic444 panel title
#. slot: background color and image
#: kidradd/comic444.htm:47
msgctxt "comic444#title.1"
msgid "\"GOOD FOR WHAT AILS YA\""
msgstr ""

#. comic444 panel p1
#. slot: right bubble
#. images: giamp.gif, nibluv2.gif
#: kidradd/comic444.htm:92
msgctxt "comic444#p1.1"
msgid "See, all Mod Cruisers contain a tracking system that continuously records their whereabouts and shares it with the others. That's why we stole one."
msgstr ""

#. comic444 panel p2
#. slot: narration (if any, else cut)
#. images: luvvy.gif, nibluv3.gif
#: kidradd/comic444.htm:137
msgctxt "comic444#p2.1"
msgid "\"I noticed from the records that there was a rogue cruiser which strayed from all others, wandering aimlessly from system to system.\""
msgstr ""

#. comic444 panel p2
#. slot: narration (if any, else cut)
#. images: luvvy.gif, nibluv3.gif
#: kidradd/comic444.htm:138
msgctxt "comic444#p2.2"
msgid "\"You mean Gnarl's?\""
msgstr ""

#. comic444 panel p3
#. slot: narration (if any, else cut)
#. images: luvvy.gif
#: kidradd/comic444.htm:191
msgctxt "comic444#p3.1"
msgid "\"If you say so. Anyways, it made a longer than average stop in this server recently, so I followed a hunch and checked it out. Sure enough, we found you guys.\""
msgstr ""

#. comic444 panel p4
#. slot: narration (if any, else cut)
#. images: luvvy.gif, nibluv4.gif
#: kidradd/comic444.htm:244
msgctxt "comic444#p4.1"
msgid "\"So if you could use a little help in your mission...\""
msgstr ""

#. comic444 panel p4
#. slot: narration (if any, else cut)
#. images: luvvy.gif, nibluv4.gif
#: kidradd/comic444.htm:245
msgctxt "comic444#p4.2"
msgid "\"Boy, you don't know how long we've been waiting to hear someone say that.\""
msgstr ""

#. comic445 panel title
#. slot: background color and image
#: kidradd/comic445.htm:49
msgctxt "comic445#title.1"
msgid "\"TAKIN' MY TIME\""
msgstr ""

#. comic445 panel p1
#. slot: left bubble
#. images: raddtback2.gif
#: kidradd/comic445.htm:90
msgctxt "comic445#p1.1"
msgid "Grr, it's like this ship is being taken over by Mods."
msgstr ""

#. comic445 panel p1
#. slot: right bubble
#. images: raddtback2.gif
#: kidradd/comic445.htm:94
msgctxt "comic445#p1.2"
msgid "<i>Ex</i>-Mods."
msgstr ""

#. comic445 panel p2
#. slot: left bubble
#. images: giradd.gif
#: kidradd/comic445.htm:142
msgctxt "comic445#p2.1"
msgid "I wanted to ask you, boy... is it true that your potential power is unlimited?"
msgstr ""

#. comic445 panel p2
#. slot: right bubble
#. images: giradd.gif
#: kidradd/comic445.htm:146
msgctxt "comic445#p2.2"
msgid "Uh, I..."
