#. comic446 panel title
#. slot: background color and image
#: kidradd/comic446.htm:47
msgctxt "comic446#title.1"
msgid "\"HARD TRUTH\""
msgstr ""

#. comic446 panel p1
#. slot: narration (if any, else cut)
#: kidradd/comic446.htm:84
msgctxt "comic446#p1.1"
msgid "Somewhere. Somewhere else."
msgstr ""

#. comic446 panel p1
#. slot: left bubble
#: kidradd/comic446.htm:90
msgctxt "comic446#p1.2"
msgid "I guess I gotta face facts."
