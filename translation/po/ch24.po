#. comic448 panel title
#. slot: background color and image
#: kidradd/comic448.htm:47
msgctxt "comic448#title.1"
msgid "\"HELP ME HELP YOU\""
msgstr ""

#. comic448 panel p1
#. slot: left bubble
#. images: gnarlhey.gif, kobastand2.gif
#: kidradd/comic448.htm:88
msgctxt "comic448#p1.1"
msgid "Listen, maybe we can help each other out here."
msgstr ""

#. comic448 panel p1
#. slot: right bubble
#. images: gnarlhey.gif, kobastand2.gif
#: kidradd/comic448.htm:92
msgctxt "comic448#p1.2"
msgid "I'm listening."
msgstr ""

#. comic448 panel p2
#. slot: left bubble
#. images: gnarlhey.gif, kobastare2.gif
#: kidradd/comic448.htm:143
msgctxt "comic448#p2.1"
msgid "All we've go to do is tutor each other in the stuff we're weak at."
msgstr ""

#. comic448 panel p2
#. slot: right bubble
#. images: gnarlhey.gif, kobastare2.gif
#: kidradd/comic448.htm:147
msgctxt "comic448#p2.2"
msgid "Hmm..."
msgstr ""

#. comic448 panel p3
#. slot: right bubble
#. images: gnarltabley.gif
#: kidradd/comic448.htm:200
msgctxt "comic448#p3.1"
msgid "For example, I can teach you to handle three dimensions. Meanwhile, you can teach me to... to.. uh..."
msgstr ""

#. comic448 panel p4
#. slot: left bubble
#. images: gnarluh.gif, kobamad2.gif
#: kidradd/comic448.htm:249
msgctxt "comic448#p4.1"
msgid "Well, I'm sure you can teach me <i>something</i>..."
msgstr ""

#. comic448 panel p4
#. slot: right bubble
#. images: gnarluh.gif, kobamad2.gif
#: kidradd/comic448.htm:253
msgctxt "comic448#p4.2"
msgid "Ninjitsu. And perhaps a little tact, hmph."
msgstr ""

#. comic449 panel title
#. slot: background color and image
#: kidradd/comic449.htm:49
msgctxt "comic449#title.1"
msgid "\"I DON'T KNOW HOW HE DOES IT, EITHER\""
msgstr ""

#. comic449 panel p1
#. slot: narration (if any, else cut)
#: kidradd/comic449.htm:86
msgctxt "comic449#p1.1"
msgid "\"Okay, let's start out very basically. I need to get a feel for your skills, so attack me.\""
msgstr ""

#. comic449 panel p1
#. slot: narration (if any, else cut)
#: kidradd/comic449.htm:87
msgctxt "comic449#p1.2"
msgid "\"Attack?\""
msgstr ""

#. comic449 panel p2
#. slot: narration (if any, else cut)
#: kidradd/comic449.htm:140
msgctxt "comic449#p2.1"
msgid "\"Yes, any way you can, it doesn't really matter. Just show me what you've got.\""
msgstr ""

#. comic449 panel p2
#. slot: narration (if any, else cut)
#: kidradd/comic449.htm:141
msgctxt "comic449#p2.2"
msgid "\"Alright.\""
msgstr ""

#. comic449 panel p3
#. slot: left bubble
#. images: gnarlblink.gif, kobastare2.gif
#: kidradd/comic449.htm:197
msgctxt "comic449#p3.1"
msgid "Whenever you're ready."
msgstr ""

#. comic449 panel p4
#. slot: insert ground "tiles" on this line
#: kidradd/comic449.htm:263
msgctxt "comic449#p4.1"
msgid "Rather thick speedlines, but they seem to work."
msgstr ""

#. comic449 panel p5
#. slot: left bubble
#. images: bgcracked.gif
#: kidradd/comic449.htm:303
msgctxt "comic449#p5.1"
msgid "How the hell did you end up in a <b>different room???</b>"
msgstr ""

#. comic449 panel p5
#. slot: right bubble
#. images: bgcracked.gif
#: kidradd/comic449.htm:307
msgctxt "comic449#p5.2"
msgid "I dunno, just help me get my fist outta the ceiling."
msgstr ""

#. comic450 panel title
#. slot: background color and image
#: kidradd/comic450.htm:47
msgctxt "comic450#title.1"
msgid "\"SMALL VICTORIES\""
msgstr ""

#. comic450 panel p1
#. slot: narration (if any, else cut)
#: kidradd/comic450.htm:84
msgctxt "comic450#p1.1"
msgid "\"Okay, let's try something else.\""
msgstr ""

#. comic450 panel p2
#. slot: left bubble
#. images: gblocks.gif
#: kidradd/comic450.htm:143
msgctxt "comic450#p2.1"
msgid "I've set up a line of blocks. Just sprint by, slashing as many as you can in one pass."
msgstr ""

#. comic450 panel p2
#. slot: right bubble
#. images: gblocks.gif
#: kidradd/comic450.htm:147
msgctxt "comic450#p2.2"
msgid "I'll give it a shot."
msgstr ""

#. comic450 panel p3
#. slot: insert ground "tiles" on this line
#: kidradd/comic450.htm:208
msgctxt "comic450#p3.1"
msgid "The strip's first \"pantyshot?\""
msgstr ""

#. comic450 panel p4
#. slot: left bubble
#. images: boxers.gif
#: kidradd/comic450.htm:248
msgctxt "comic450#p4.1"
msgid "I hit something! I actually hit something!"
msgstr ""

#. comic450 panel p4
#. slot: right bubble
#. images: boxers.gif
#: kidradd/comic450.htm:252
msgctxt "comic450#p4.2"
msgid "Your own belt doesn't count..."
msgstr ""

#. comic451 panel title
#. slot: background color and image
#: kidradd/comic451.htm:61
msgctxt "comic451#title.1"
msgid "\"CONUNDRUM\""
msgstr ""

#. comic451 panel p1
#. slot: right bubble
#: kidradd/comic451.htm:106
msgctxt "comic451#p1.1"
msgid "Touch the block."
msgstr ""

#. comic451 panel p2
#. slot: right bubble
#: kidradd/comic451.htm:158
msgctxt "comic451#p2.1"
msgid "Attack the block."
msgstr ""

#. comic451 panel p3
#. slot: right bubble
#: kidradd/comic451.htm:210
msgctxt "comic451#p3.1"
msgid "Touch the block."
msgstr ""

#. comic451 panel p4
#. slot: right bubble
#: kidradd/comic451.htm:263
msgctxt "comic451#p4.1"
msgid "Attack the block."
msgstr ""

#. comic451 panel p5
#. slot: left bubble
#. images: ggive.gif
#: kidradd/comic451.htm:312
msgctxt "comic451#p5.1"
msgid "Is there a point to this?"
msgstr ""

#. comic451 panel p5
#. slot: right bubble
#. images: ggive.gif
#: kidradd/comic451.htm:316
msgctxt "comic451#p5.2"
msgid "Probably, I just gotta figure it out."
msgstr ""

#. comic452 panel title
#. slot: background color and image
#: kidradd/comic452.htm:34
msgctxt "comic452#title.1"
msgid "\"ENIGMA\""
msgstr ""

#. comic452 panel p1
#. slot: left bubble
#. images: gnarlright.gif, kobastand2.gif
#: kidradd/comic452.htm:75
msgctxt "comic452#p1.1"
msgid "Dude, the way you spectacularly mess up every attack is just... impossible."
msgstr ""

#. comic452 panel p1
#. slot: right bubble
#. images: gnarlright.gif, kobastand2.gif
#: kidradd/comic452.htm:79
msgctxt "comic452#p1.2"
msgid "What do you mean?"
msgstr ""

#. comic452 panel p2
#. slot: left bubble
#. images: gnarlstand.gif, kobastand2.gif
#: kidradd/comic452.htm:130
msgctxt "comic452#p2.1"
msgid "When you're not attacking, you seem to handle the world just fine. You don't have trouble walking or climbing stairs or whatever."
msgstr ""

#. comic452 panel p2
#. slot: right bubble
#. images: gnarlstand.gif, kobastand2.gif
#: kidradd/comic452.htm:134
msgctxt "comic452#p2.2"
msgid "I guess not, but what does that mean?"
msgstr ""

#. comic452 panel p3
#. slot: left bubble
#. images: gnarltable.gif, kobatable2b.gif
#: kidradd/comic452.htm:182
msgctxt "comic452#p3.1"
msgid "It means your problem can't be just depth perception. Maybe it's a pre-programmed thing."
msgstr ""

#. comic452 panel p3
#. slot: right bubble
#. images: gnarltable.gif, kobatable2b.gif
#: kidradd/comic452.htm:186
msgctxt "comic452#p3.2"
msgid "So what then?"
msgstr ""

#. comic452 panel p4
#. slot: left bubble
#. images: psych.gif
#: kidradd/comic452.htm:234
msgctxt "comic452#p4.1"
msgid "So tell me about your game."
msgstr ""

#. comic452 panel p4
#. slot: right bubble
#. images: psych.gif
#: kidradd/comic452.htm:238
msgctxt "comic452#p4.2"
msgid "I was afraid you were gonna ask that..."
msgstr ""

#. comic453 panel title
#. slot: background color and image
#: kidradd/comic453.htm:46
msgctxt "comic453#title.1"
msgid "\"RIDDLE\""
msgstr ""

#. comic453 panel p1
#. slot: middle bubble
#. images: kheadsad.gif
#: kidradd/comic453.htm:90
msgctxt "comic453#p1.1"
msgid "I don't like to talk about my origins. It's a shameful secret that I've been keeping my entire life..."
msgstr ""

#. comic453 panel p2
#. slot: narration (if any, else cut)
#: kidradd/comic453.htm:140
msgctxt "comic453#p2.1"
msgid "\"Unlike most sprites, I'm not from an obsolete console. I'm from a mediocre novelty game, the kind that are rather commonplace on the web.\""
msgstr ""

#. comic453 panel p3
#. slot: narration (if any, else cut)
#. images: bgbash2.gif
#: kidradd/comic453.htm:193
msgctxt "comic453#p3.1"
msgid "\"It wasn't a game designed for a challenge - heck, it wasn't much of a game at all. It was a way for humans to act out their strange aggressive nature on an endless supply of ninjas, in a number of creative ways.\""
msgstr ""

#. comic453 panel p4
#. slot: narration (if any, else cut)
#: kidradd/comic453.htm:248
msgctxt "comic453#p4.1"
msgid "\"Just in case you've never noticed, let me be the first to say that humans have a cruel sense of humor.\""
msgstr ""

#. comic453 panel p4
#. slot: narration (if any, else cut)
#: kidradd/comic453.htm:249
msgctxt "comic453#p4.2"
msgid "\"A common observation.\""
msgstr ""

#. comic454 panel title
#. slot: background color and image
#: kidradd/comic454.htm:46
msgctxt "comic454#title.1"
msgid "\"THAT TIME IS NOW\""
msgstr ""

#. comic454 panel p1
#. slot: left bubble
#. images: gnarlsigh.gif, kobastand2.gif
#: kidradd/comic454.htm:87
msgctxt "comic454#p1.1"
msgid "This sounds bad. So you can't attack at all?"
msgstr ""

#. comic454 panel p1
#. slot: right bubble
#. images: gnarlsigh.gif, kobastand2.gif
#: kidradd/comic454.htm:91
msgctxt "comic454#p1.2"
msgid "Sure I can."
msgstr ""

#. comic454 panel p2
#. slot: left bubble
#. images: gnarlstand.gif, kobapose.gif
#: kidradd/comic454.htm:142
msgctxt "comic454#p2.1"
msgid "But..."
msgstr ""

#. comic454 panel p2
#. slot: right bubble
#. images: gnarlstand.gif, kobapose.gif
#: kidradd/comic454.htm:146
msgctxt "comic454#p2.2"
msgid "But I'm supposed to do a bunch of ninja-ish stuff while the player's deciding how to clobber me."
msgstr ""

#. comic454 panel p3
#. slot: narration (if any, else cut)
#: kidradd/comic454.htm:190
msgctxt "comic454#p3.1"
msgid "\"If the human waited around doing nothing for too long, I'd do a 'real' attack, and the game would end with a snide remark.\""
msgstr ""

#. comic454 panel p4
#. slot: left bubble
#. images: gnarlcross.gif, kobablink2.gif
#: kidradd/comic454.htm:249
msgctxt "comic454#p4.1"
msgid "In other words, you only attacked if the player was stupid."
msgstr ""

#. comic454 panel p4
#. slot: right bubble
#. images: gnarlcross.gif, kobablink2.gif
#: kidradd/comic454.htm:253
msgctxt "comic454#p4.2"
msgid "Are you kidding? If I did that, I'd hafta kill everyone who played that damn game."
msgstr ""

#. comic455 panel title
#. slot: background color and image
#: kidradd/comic455.htm:46
msgctxt "comic455#title.1"
msgid "\"JUST ANOTHER NERVOUS WRECK\""
msgstr ""

#. comic455 panel p1
#. slot: right bubble
#. images: gnarlback2.gif, kobastand2.gif
#: kidradd/comic455.htm:91
msgctxt "comic455#p1.1"
msgid "Koba, we're sprites. We're made a certain way, and there are certain things we can't change. Your personal gravity, inertia and other physics are an integral part of you."
msgstr ""

#. comic455 panel p2
#. slot: right bubble
#. images: gnarlright.gif, kobastand2.gif
#: kidradd/comic455.htm:146
msgctxt "comic455#p2.1"
msgid "But while variables like those are set in stone, your personal behavior is a different matter. You don't have to follow the same routines you did back in your game. You're free now."
msgstr ""

#. comic455 panel p3
#. slot: narration (if any, else cut)
#: kidradd/comic455.htm:190
msgctxt "comic455#p3.1"
msgid "\"I'm willing to bet that your inability to attack is only a mental block - just you acting out the character your programmer made you to be. If you're willing to change, I bet you can overcome those habits.\""
msgstr ""

#. comic455 panel p4
#. slot: left bubble
#. images: gksit.gif
#: kidradd/comic455.htm:249
msgctxt "comic455#p4.1"
msgid "Wow. You sound like you really know what you're talking about."
msgstr ""

#. comic455 panel p4
#. slot: right bubble
#. images: gksit.gif
#: kidradd/comic455.htm:253
msgctxt "comic455#p4.2"
msgid "Sorta. I'm still kinda learning this \"individuality\" stuff myself..."
msgstr ""

#. comic456 panel title
#. slot: background color and image
#: kidradd/comic456.htm:47
msgctxt "comic456#title.1"
msgid "\"DON'T LOOK BACK IN ANGER\""
msgstr ""

#. comic456 panel p1
#. slot: narration (if any, else cut)
#. images: julietabler.gif, nibluv2.gif
#: kidradd/comic456.htm:84
msgctxt "comic456#p1.1"
msgid "Life carries on in the High Score, as the previous residents adjust to their new crewmates."
msgstr ""

#. comic456 panel p4
#. slot: left bubble
#. images: jhee.gif
#: kidradd/comic456.htm:247
msgctxt "comic456#p4.1"
msgid "That's better."
msgstr ""

#. comic456 panel p4
#. slot: middle bubble
#. images: jhee.gif
#: kidradd/comic456.htm:249
msgctxt "comic456#p4.2"
msgid "What the heck was she implying?"
msgstr ""

#. comic456 panel p4
#. slot: right bubble
#. images: jhee.gif
#: kidradd/comic456.htm:251
msgctxt "comic456#p4.3"
msgid "Not a clue. Say, I've got an idea..."
msgstr ""

#. comic457 panel title
#. slot: background color and image
#: kidradd/comic457.htm:34
msgctxt "comic457#title.1"
msgid "\"INSINUATIONS\""
msgstr ""

#. comic457 panel p1
#. slot: middle bubble
#. images: jbackfly.gif
#: kidradd/comic457.htm:77
msgctxt "comic457#p1.1"
msgid "Hmmm..."
msgstr ""

#. comic457 panel p2
#. slot: right bubble
#. images: giback.gif, juliefmad2.gif
#: kidradd/comic457.htm:133
msgctxt "comic457#p2.1"
msgid "Hey, freaky-looking Mister! Whatcha bothering my Radd for?"
msgstr ""

#. comic457 panel p3
#. slot: left bubble
#. images: giright.gif, juliefmad2.gif
#: kidradd/comic457.htm:181
msgctxt "comic457#p3.1"
msgid "What? Oh, nothing."
msgstr ""

#. comic457 panel p3
#. slot: right bubble
#. images: giright.gif, juliefmad2.gif
#: kidradd/comic457.htm:185
msgctxt "comic457#p3.2"
msgid "Nothing? You're knocking on his door in the middle of the night!"
msgstr ""

#. comic457 panel p4
#. slot: left bubble
#. images: giguy.gif, juliefno2.gif
#: kidradd/comic457.htm:233
msgctxt "comic457#p4.1"
msgid "What exactly are you implying?"
msgstr ""

#. comic457 panel p4
#. slot: right bubble
#. images: giguy.gif, juliefno2.gif
#: kidradd/comic457.htm:237
msgctxt "comic457#p4.2"
msgid "Why does everyone ask me that? I don't get it..."
msgstr ""

#. comic458 panel title
#. slot: background color and image
#: kidradd/comic458.htm:34
msgctxt "comic458#title.1"
msgid "\"NO HURRY\""
msgstr ""

#. comic458 panel p1
#. slot: left bubble
#. images: thought2.gif, gitable2.gif, juliefmad2.gif
#: kidradd/comic458.htm:75
msgctxt "comic458#p1.1"
msgid "Damn this crowded little ship. You can't walk five feet without tripping over somebody."
msgstr ""

#. comic458 panel p2
#. slot: left bubble
#. images: thought2.gif, gileft.gif
#: kidradd/comic458.htm:128
msgctxt "comic458#p2.1"
msgid "But I can't have the others around... I've got to confront Radd alone for this to happen. What a bother."
msgstr ""

#. comic458 panel p3
#. slot: left bubble
#. images: thought2.gif, gitable2.gif
#: kidradd/comic458.htm:180
msgctxt "comic458#p3.1"
msgid "Sigh, I'll just have to be patient a bit longer. An opportunity will present itself soon enough."
msgstr ""

#. comic458 panel p4
#. slot: left bubble
#. images: thought2.gif, atoaster.gif, gileft.gif
#: kidradd/comic458.htm:230
msgctxt "comic458#p4.1"
msgid "It's a toaster!"
msgstr ""

#. comic458 panel p4
#. slot: middle bubble
#. images: thought2.gif, atoaster.gif, gileft.gif
#: kidradd/comic458.htm:232
msgctxt "comic458#p4.2"
msgid "Toasted power-ups?..."
msgstr ""

#. comic458 panel p4
#. slot: right bubble
#. images: thought2.gif, atoaster.gif, gileft.gif
#: kidradd/comic458.htm:234
msgctxt "comic458#p4.3"
msgid "Assuming I can survive that long."
msgstr ""

#. comic459 panel title
#. slot: background color and image
#: kidradd/comic459.htm:35
msgctxt "comic459#title.1"
msgid "\"EYES ONLY\""
msgstr ""

#. comic459 panel p1
#. slot: narration (if any, else cut)
#: kidradd/comic459.htm:72
msgctxt "comic459#p1.1"
msgid "\"RADD, CAN YOU HEAR ME?\""
msgstr ""

#. comic459 panel p2
#. slot: middle bubble
#. images: seer.gif
#: kidradd/comic459.htm:133
msgctxt "comic459#p2.1"
msgid "I FEAR I'VE MADE A TERRIBLE OVERSIGHT. THERE'S A THREAT TO YOU I DIDN'T FORESEE."
msgstr ""

#. comic459 panel p3
#. slot: middle bubble
#. images: seer.gif
#: kidradd/comic459.htm:202
msgctxt "comic459#p3.1"
msgid "LISTEN CAREFULLY. YOU MUST REALIZE THE DANGER INHERENT TO YOUR POWERS. YOU HAVE TO STAY AWAY FROM -"
msgstr ""

#. comic459 panel p4
#. slot: right bubble
#. images: raddbed2.gif, amptoast2.gif
#: kidradd/comic459.htm:256
msgctxt "comic459#p4.1"
msgid "WAFFLES!!!"
msgstr ""

#. comic459 panel p5
#. slot: left bubble
#. images: raddtablem.gif, sheenatable2.gif, bogeytable11.gif, star2.gif, plant2.gif, shroom2.gif
#: kidradd/comic459.htm:305
msgctxt "comic459#p5.1"
msgid "These aren't waffles..."
msgstr ""

#. comic459 panel p5
#. slot: middle bubble
#. images: raddtablem.gif, sheenatable2.gif, bogeytable11.gif, star2.gif, plant2.gif, shroom2.gif
#: kidradd/comic459.htm:307
msgctxt "comic459#p5.2"
msgid "Just humor the guy, it makes him feel needed."
msgstr ""

#. comic459 panel p5
#. slot: right bubble
#. images: raddtablem.gif, sheenatable2.gif, bogeytable11.gif, star2.gif, plant2.gif, shroom2.gif
#: kidradd/comic459.htm:309
msgctxt "comic459#p5.3"
msgid "Crispy!"
msgstr ""
