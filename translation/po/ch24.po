#. comic426 panel title
#. slot: background color and image
#: kidradd/comic426.htm:34
msgctxt "comic426#title.1"
msgid "\"KNOCK THREE TIMES\""
msgstr ""

#. comic426 panel p1
#. slot: narration (if any, else cut)
#. images: msheenatable.gif
#: kidradd/comic426.htm:71
msgctxt "comic426#p1.1"
msgid "The random search for allies continues..."
msgstr ""

#. comic426 panel p1
#. slot: middle bubble
#. images: msheenatable.gif
#: kidradd/comic426.htm:79
msgctxt "comic426#p1.2"
msgid "Um, hi everyone. We're here on sort of a recruiting mission."
msgstr ""

#. comic426 panel p2
#. slot: middle bubble
#. images: msheenatable2.gif
#: kidradd/comic426.htm:134
msgctxt "comic426#p2.1"
msgid "See, we're trying to find sprites with unique powers who would like to help us overthrow an evil empire."
msgstr ""

#. comic426 panel p3
#. slot: middle bubble
#. images: msheenabtable.gif
#: kidradd/comic426.htm:185
msgctxt "comic426#p3.1"
msgid "So if any of you think you would qualify, and are interested in joining in, please volunteer!"
msgstr ""

#. comic426 panel p4
#. slot: left bubble
#. images: slime.gif, msheenaleft.gif, raddright.gif
#: kidradd/comic426.htm:237
msgctxt "comic426#p4.1"
msgid "Uh, one jiggle for yes, two for no?"
msgstr ""

#. comic426 panel p4
#. slot: middle bubble
#. images: slime.gif, msheenaleft.gif, raddright.gif
#: kidradd/comic426.htm:239
msgctxt "comic426#p4.2"
msgid "I think this one said, \"Okay.\""
msgstr ""

#. comic426 panel p4
#. slot: right bubble
#. images: slime.gif, msheenaleft.gif, raddright.gif
#: kidradd/comic426.htm:241
msgctxt "comic426#p4.3"
msgid "<b>GrglGrglGr!</b></font><font size=\"1\" face=\"arial\"><br><b>*</b>(Mmm! Tasties!)"
msgstr ""

#. comic427 panel title
#. slot: background color and image
#: kidradd/comic427.htm:47
msgctxt "comic427#title.1"
msgid "\"PUSHING IT\""
msgstr ""

#. comic427 panel p1
#. slot: left bubble
#. images: heyslime.gif
#: kidradd/comic427.htm:88
msgctxt "comic427#p1.1"
msgid "I don't believe they understand us."
msgstr ""

#. comic427 panel p1
#. slot: right bubble
#. images: heyslime.gif
#: kidradd/comic427.htm:92
msgctxt "comic427#p1.2"
msgid "Oh, you are so <b>not</b> thinking of attacking me dude..."
msgstr ""

#. comic427 panel p2
#. slot: left bubble
#. images: heyslime2.gif
#: kidradd/comic427.htm:144
msgctxt "comic427#p2.1"
msgid "Maybe we should just leave."
msgstr ""

#. comic427 panel p2
#. slot: right bubble
#. images: heyslime2.gif
#: kidradd/comic427.htm:148
msgctxt "comic427#p2.2"
msgid "Now you're asking for it!"
msgstr ""

#. comic427 panel p3
#. slot: left bubble
#. images: heyslime2.gif, bslime.gif
#: kidradd/comic427.htm:196
msgctxt "comic427#p3.1"
msgid "Uh, that doesn't seem to be hurting it."
msgstr ""

#. comic427 panel p3
#. slot: right bubble
#. images: heyslime2.gif, bslime.gif
#: kidradd/comic427.htm:200
msgctxt "comic427#p3.2"
msgid "Just give it a moment..."
msgstr ""

#. comic427 panel p4
#. slot: left bubble
#. images: heyslime3.gif, bslime.gif
#: kidradd/comic427.htm:250
msgctxt "comic427#p4.1"
msgid "Is it time to run yet?"
msgstr ""

#. comic427 panel p4
#. slot: right bubble
#. images: heyslime3.gif, bslime.gif
#: kidradd/comic427.htm:254
msgctxt "comic427#p4.2"
msgid "You really don't get this \"hero\" gig, do ya?"
msgstr ""

#. comic428 panel title
#. slot: background color and image
#: kidradd/comic428.htm:53
msgctxt "comic428#title.1"
msgid "\"FOR THE VERY FIRST TIME\""
msgstr ""

#. comic428 panel p1
#. slot: left bubble
#. images: heyslime3.gif, bslime.gif
#: kidradd/comic428.htm:94
msgctxt "comic428#p1.1"
msgid "We gotta run!"
msgstr ""

#. comic428 panel p1
#. slot: right bubble
#. images: heyslime3.gif, bslime.gif
#: kidradd/comic428.htm:98
msgctxt "comic428#p1.2"
msgid "Don't give up yet! Do one of your screen-clearing attack thingies!"
msgstr ""

#. comic428 panel p2
#. slot: left bubble
#. images: heyslime4.gif, bslime2.gif
#: kidradd/comic428.htm:150
msgctxt "comic428#p2.1"
msgid "Sorry, I gotta throw a few hundred shots first."
msgstr ""

#. comic428 panel p2
#. slot: right bubble
#. images: heyslime4.gif, bslime2.gif
#: kidradd/comic428.htm:154
msgctxt "comic428#p2.2"
msgid "Then start shooting!"
msgstr ""

#. comic428 panel p3
#. slot: left bubble
#: kidradd/comic428.htm:202
msgctxt "comic428#p3.1"
msgid "Did the Mega Radd work?"
msgstr ""

#. comic428 panel p3
#. slot: right bubble
#: kidradd/comic428.htm:206
msgctxt "comic428#p3.2"
msgid "Nope."
msgstr ""

#. comic428 panel p5
#. slot: left bubble
#. images: heyslime5.gif, bslime.gif
#: kidradd/comic428.htm:287
msgctxt "comic428#p5.1"
msgid "That <b>hurt!</b>"
msgstr ""

#. comic428 panel p5
#. slot: right bubble
#. images: heyslime5.gif, bslime.gif
#: kidradd/comic428.htm:291
msgctxt "comic428#p5.2"
msgid "Sheesh, as if you'd never felt pain befo- ...Oh, right."
msgstr ""

#. comic429 panel title
#. slot: background color and image
#: kidradd/comic429.htm:34
msgctxt "comic429#title.1"
msgid "\"HIT BETWEEN THE EYES\""
msgstr ""

#. comic429 panel p1
#. slot: left bubble
#. images: julie.gif, bogeysigh.gif, ampstand.gif
#: kidradd/comic429.htm:75
msgctxt "comic429#p1.1"
msgid "So many games here... and we're still just going in blind."
msgstr ""

#. comic429 panel p1
#. slot: right bubble
#. images: julie.gif, bogeysigh.gif, ampstand.gif
#: kidradd/comic429.htm:79
msgctxt "comic429#p1.2"
msgid "Well, they're not <i>all</i> games, but yeah."
msgstr ""

#. comic429 panel p2
#. slot: left bubble
#. images: bogeytable7.gif, amptable2.gif
#: kidradd/comic429.htm:130
msgctxt "comic429#p2.1"
msgid "They aren't?"
msgstr ""

#. comic429 panel p2
#. slot: right bubble
#. images: bogeytable7.gif, amptable2.gif
#: kidradd/comic429.htm:134
msgctxt "comic429#p2.2"
msgid "Some of 'em are those mysterious \"txt\" files with the humans' weird language on 'em. Pretty useless to us."
msgstr ""

#. comic429 panel p3
#. slot: left bubble
#. images: amptable.gif, julie2.gif, bogeytable8.gif
#: kidradd/comic429.htm:179
msgctxt "comic429#p3.1"
msgid "Oh look, they're back at the dropoff point already. Done so soon?"
msgstr ""

#. comic429 panel p3
#. slot: right bubble
#. images: amptable.gif, julie2.gif, bogeytable8.gif
#: kidradd/comic429.htm:183
msgctxt "comic429#p3.2"
msgid "Probably another recruiting failure. Better bring 'em in."
msgstr ""

#. comic429 panel p4
#. slot: left bubble
#. images: sheenablink.gif, raddslime.gif, julieno2.gif, bogeytalk2.gif, ampstand2.gif
#: kidradd/comic429.htm:230
msgctxt "comic429#p4.1"
msgid "Uh, things didn't go so well..."
msgstr ""

#. comic429 panel p4
#. slot: middle bubble
#. images: sheenablink.gif, raddslime.gif, julieno2.gif, bogeytalk2.gif, ampstand2.gif
#: kidradd/comic429.htm:232
msgctxt "comic429#p4.2"
msgid "Hey, you finally brought something back!"
msgstr ""

#. comic429 panel p4
#. slot: right bubble
#. images: sheenablink.gif, raddslime.gif, julieno2.gif, bogeytalk2.gif, ampstand2.gif
#: kidradd/comic429.htm:234
msgctxt "comic429#p4.3"
msgid "I like the change of color-scheme."
msgstr ""

#. comic430 panel title
#. slot: background color and image
#: kidradd/comic430.htm:47
msgctxt "comic430#title.1"
msgid "\"THE HERO\""
msgstr ""

#. comic430 panel p1
#. slot: left bubble
#. images: raddslime.gif, sheenablink.gif, bogeystand2.gif, julieno2.gif
#: kidradd/comic430.htm:88
msgctxt "comic430#p1.1"
msgid "He doesn't seem hurt, but he's immobile. I had to drag him back."
msgstr ""

#. comic430 panel p1
#. slot: middle bubble
#. images: raddslime.gif, sheenablink.gif, bogeystand2.gif, julieno2.gif
#: kidradd/comic430.htm:90
msgctxt "comic430#p1.2"
msgid "Why didn't they get you?"
msgstr ""

#. comic430 panel p1
#. slot: right bubble
#. images: raddslime.gif, sheenablink.gif, bogeystand2.gif, julieno2.gif
#: kidradd/comic430.htm:92
msgctxt "comic430#p1.3"
msgid "Oh, Radd..."
msgstr ""

#. comic430 panel p2
#. slot: left bubble
#. images: raddslime.gif, sheenastand.gif, bogeysigh4.gif, juliefmad2.gif
#: kidradd/comic430.htm:143
msgctxt "comic430#p2.1"
msgid "When they tried, I instinctively flipped back to NPC mode, so they couldn't."
msgstr ""

#. comic430 panel p2
#. slot: right bubble
#. images: raddslime.gif, sheenastand.gif, bogeysigh4.gif, juliefmad2.gif
#: kidradd/comic430.htm:147
msgctxt "comic430#p2.2"
msgid "You coward! You should be slimed, too!"
msgstr ""

#. comic430 panel p3
#. slot: left bubble
#. images: sheenatableg.gif, amptable2.gif
#: kidradd/comic430.htm:194
msgctxt "comic430#p3.1"
msgid "I'll ignore that. Dr. Amp, can't you do something?"
msgstr ""

#. comic430 panel p3
#. slot: middle bubble
#. images: sheenatableg.gif, amptable2.gif
#: kidradd/comic430.htm:196
msgctxt "comic430#p3.2"
msgid "Probably not, this seems like one of those game mechanics problems..."
msgstr ""

#. comic430 panel p3
#. slot: right bubble
#. images: sheenatableg.gif, amptable2.gif
#: kidradd/comic430.htm:198
msgctxt "comic430#p3.3"
msgid "Ahem..."
msgstr ""

#. comic430 panel p4
#. slot: middle bubble
#: kidradd/comic430.htm:248
msgctxt "comic430#p4.1"
msgid "Getcher \"thank-yous\" ready, cuz it's finally <b>my</b> turn to save the day!"
msgstr ""

#. comic431 panel title
#. slot: background color and image
#: kidradd/comic431.htm:34
msgctxt "comic431#title.1"
msgid "\"MORE THAN WORDS\""
msgstr ""

#. comic431 panel p1
#. slot: left bubble
#. images: grrgrr.gif, ampstand.gif, bogeystool.gif
#: kidradd/comic431.htm:75
msgctxt "comic431#p1.1"
msgid "I don't get it, Bogey. What are you planning?"
msgstr ""

#. comic431 panel p1
#. slot: right bubble
#. images: grrgrr.gif, ampstand.gif, bogeystool.gif
#: kidradd/comic431.htm:79
msgctxt "comic431#p1.2"
msgid "Take a look at the code of one of those \"useless\" files you mentioned."
msgstr ""

#. comic431 panel p2
#. slot: left bubble
#. images: amptableb.gif, bogeytable9.gif
#: kidradd/comic431.htm:129
msgctxt "comic431#p2.1"
msgid "Well, uh..."
msgstr ""

#. comic431 panel p2
#. slot: right bubble
#. images: amptableb.gif, bogeytable9.gif
#: kidradd/comic431.htm:133
msgctxt "comic431#p2.2"
msgid "Just read it!"
msgstr ""

#. comic431 panel p3
#. slot: right bubble
#. images: amptableb.gif, bogeytable10.gif
#: kidradd/comic431.htm:184
msgctxt "comic431#p3.1"
msgid "Okay, I'll try. Ahem.<br>\"Hit-mel? ...Body! Brr... ...Her?\""
msgstr ""

#. comic431 panel p4
#. slot: left bubble
#. images: amptable.gif, bogeytable6.gif
#: kidradd/comic431.htm:232
msgctxt "comic431#p4.1"
msgid "Boy, these \"htm\" files make even less sense than the \"txt\" ones."
msgstr ""

#. comic431 panel p4
#. slot: right bubble
#. images: amptable.gif, bogeytable6.gif
#: kidradd/comic431.htm:236
msgctxt "comic431#p4.2"
msgid "At times like these, I remember why I used to walk off cliffs so effortlessly."
msgstr ""

#. comic431 panel p4
#. slot: bubble "stems"
#. images: amptable.gif, bogeytable6.gif
#: kidradd/comic431.htm:242
msgctxt "comic431#p4.3"
msgid "&lt;html&gt;<br>&lt;body&gt;<br>&lt;br&gt;<br>&lt;hr&gt;<br>&lt;h1&gt;<br>Old Daedalus"
msgstr ""

#. comic432 panel title
#. slot: background color and image
#: kidradd/comic432.htm:34
msgctxt "comic432#title.1"
msgid "\"CAN'T EXPLAIN\""
msgstr ""

#. comic432 panel p1
#. slot: left bubble
#. images: grouphmm.gif
#: kidradd/comic432.htm:75
msgctxt "comic432#p1.1"
msgid "Just ignore the stuff in the brackets, and skip the \"lol\" and \"wtf\"-type stuff."
msgstr ""

#. comic432 panel p1
#. slot: right bubble
#. images: grouphmm.gif
#: kidradd/comic432.htm:79
msgctxt "comic432#p1.2"
msgid "Even that doesn't make much sense, it's like another language."
msgstr ""

#. comic432 panel p2
#. slot: left bubble
#. images: amptableb.gif, bogeytable9.gif
#: kidradd/comic432.htm:129
msgctxt "comic432#p2.1"
msgid "\"Old Daedalus: Walkthroughs! FAQs! Tips and Secrets!\" ...What does any of that mean?"
msgstr ""

#. comic432 panel p2
#. slot: right bubble
#. images: amptableb.gif, bogeytable9.gif
#: kidradd/comic432.htm:133
msgctxt "comic432#p2.2"
msgid "Alright, I'll make it simple:"
msgstr ""

#. comic432 panel p3
#. slot: middle bubble
#. images: bheadsay.gif
#: kidradd/comic432.htm:183
msgctxt "comic432#p3.1"
msgid "You mentioned that this odd place is some sort of site where humans download games. Well, I believe these files here are like cheat sheets to help humans win those games."
msgstr ""

#. comic432 panel p4
#. slot: left bubble
#. images: grouphmm2.gif
#: kidradd/comic432.htm:233
msgctxt "comic432#p4.1"
msgid "Oh... humans aren't too good at figuring stuff out by themselves, are they?"
msgstr ""

#. comic432 panel p4
#. slot: right bubble
#. images: grouphmm2.gif
#: kidradd/comic432.htm:237
msgctxt "comic432#p4.2"
msgid "Sorta like someone else I know. Step aside doc, I've got some reading to do..."
msgstr ""

#. comic433 panel title
#. slot: background color and image
#: kidradd/comic433.htm:46
msgctxt "comic433#title.1"
msgid "\"KIND OF A DRAG\""
msgstr ""

#. comic433 panel p1
#. slot: right bubble
#. images: grouphmm.gif
#: kidradd/comic433.htm:91
msgctxt "comic433#p1.1"
msgid "Here we go: \"The Avocado Slime Creeps, annoying dungeon denizens.\""
msgstr ""

#. comic433 panel p2
#. slot: right bubble
#. images: sheenatable.gif, bogeytable5.gif
#: kidradd/comic433.htm:146
msgctxt "comic433#p2.1"
msgid "\"These creatures like to attach themselves to the hero, rendering him unable to attack and gradually immobilizing him.\""
msgstr ""

#. comic433 panel p3
#. slot: right bubble
#. images: sheenatable.gif, bogeytable9.gif
#: kidradd/comic433.htm:198
msgctxt "comic433#p3.1"
msgid "\"When in this defenseless state, the hero has no choice but to find a Nurse's Station before it's too late.\" There Sheena, that's the answer! Find the Nurse, and you'll cure Radd!"
msgstr ""

#. comic433 panel p5
#. slot: left bubble
#. images: sheenasmug.gif, juliefglad2.gif, bogeystool4.gif
#: kidradd/comic433.htm:279
msgctxt "comic433#p5.1"
msgid "Julie, sweetie! How'd you like to go in this time?"
msgstr ""

#. comic433 panel p5
#. slot: middle bubble
#. images: sheenasmug.gif, juliefglad2.gif, bogeystool4.gif
#: kidradd/comic433.htm:281
msgctxt "comic433#p5.2"
msgid "Yay! I'll do it!"
msgstr ""

#. comic433 panel p5
#. slot: right bubble
#. images: sheenasmug.gif, juliefglad2.gif, bogeystool4.gif
#: kidradd/comic433.htm:283
msgctxt "comic433#p5.3"
msgid "Uh, no."
msgstr ""

#. comic434 panel title
#. slot: background color and image
#: kidradd/comic434.htm:49
msgctxt "comic434#title.1"
msgid "\"INFATUATION\""
msgstr ""

#. comic434 panel p1
#. slot: left bubble
#. images: grouphmm3.gif
#: kidradd/comic434.htm:90
msgctxt "comic434#p1.1"
msgid "Alright Sheena, let's go!"
msgstr ""

#. comic434 panel p1
#. slot: right bubble
#. images: grouphmm3.gif
#: kidradd/comic434.htm:94
msgctxt "comic434#p1.2"
msgid "What, us? Me and you?"
msgstr ""

#. comic434 panel p2
#. slot: left bubble
#. images: backslime.gif, bogeytalk2.gif, grouphuh2.gif
#: kidradd/comic434.htm:145
msgctxt "comic434#p2.1"
msgid "Yeah, we're going to bring that \"Nurse\" character here, so she can save Radd."
msgstr ""

#. comic434 panel p2
#. slot: right bubble
#. images: backslime.gif, bogeytalk2.gif, grouphuh2.gif
#: kidradd/comic434.htm:149
msgctxt "comic434#p2.2"
msgid "But is it safe? For you, I mean..."
msgstr ""

#. comic434 panel p3
#. slot: left bubble
#. images: bogeyhrun2.gif, sheenarun2.gif
#: kidradd/comic434.htm:196
msgctxt "comic434#p3.1"
msgid "Look, enemy sprites won't attack me, and they can't attack you as long as you're in NPC mode. We'll be fine."
msgstr ""

#. comic434 panel p3
#. slot: right bubble
#. images: bogeyhrun2.gif, sheenarun2.gif
#: kidradd/comic434.htm:200
msgctxt "comic434#p3.2"
msgid "But if a hero's in there, and he attacks you..."
msgstr ""

#. comic434 panel p4
#. slot: middle bubble
#. images: bogeyruns.gif
#: kidradd/comic434.htm:251
msgctxt "comic434#p4.1"
msgid "...Then you'll flip modes and kick his butt. But frankly, he's probably already defeated and won't revive until the next game is played. Otherwise you would've met him already."
msgstr ""

#. comic434 panel p5
#. slot: left bubble
#. images: sheenatback.gif, bogeydown2.gif
#: kidradd/comic434.htm:303
msgctxt "comic434#p5.1"
msgid "Yeah, but..."
msgstr ""

#. comic434 panel p5
#. slot: right bubble
#. images: sheenatback.gif, bogeydown2.gif
#: kidradd/comic434.htm:307
msgctxt "comic434#p5.2"
msgid "But what? What possible reason could you have to be hesitant?"
msgstr ""

#. comic434 panel p7
#. slot: left bubble
#. images: sheenablink.gif, bogeyjoy2.gif
#: kidradd/comic434.htm:379
msgctxt "comic434#p7.1"
msgid "...No particular reason."
msgstr ""

#. comic434 panel p7
#. slot: middle bubble
#. images: sheenablink.gif, bogeyjoy2.gif
#: kidradd/comic434.htm:381
msgctxt "comic434#p7.2"
msgid "In romantic dimly-lit dungeons!"
msgstr ""

#. comic434 panel p7
#. slot: right bubble
#. images: sheenablink.gif, bogeyjoy2.gif
#: kidradd/comic434.htm:383
msgctxt "comic434#p7.3"
msgid "'Kay then! Time to say, \"Helloooo Nurse!\""
msgstr ""

#. comic435 panel title
#. slot: background color and image
#: kidradd/comic435.htm:47
msgctxt "comic435#title.1"
msgid "\"CAN'T HOLD BACK\""
msgstr ""

#. comic435 panel p1
#. slot: left bubble
#. images: thought.gif, slime.gif, bogeytalk2.gif, sheenaleft.gif
#: kidradd/comic435.htm:88
msgctxt "comic435#p1.1"
msgid "Ah, exploring a game again. It's been too long."
msgstr ""

#. comic435 panel p1
#. slot: middle bubble
#. images: thought.gif, slime.gif, bogeytalk2.gif, sheenaleft.gif
#: kidradd/comic435.htm:90
msgctxt "comic435#p1.2"
msgid "Oh, he's sooo cute!"
msgstr ""

#. comic435 panel p1
#. slot: right bubble
#. images: thought.gif, slime.gif, bogeytalk2.gif, sheenaleft.gif
#: kidradd/comic435.htm:92
msgctxt "comic435#p1.3"
msgid "Don't even think of it."
msgstr ""

#. comic435 panel p2
#. slot: left bubble
#. images: thought.gif, bogeytwalk2.gif, sheenamwalk2.gif
#: kidradd/comic435.htm:144
msgctxt "comic435#p2.1"
msgid "Now that we can identify the games by their related files, I'll get to do this more often!!"
msgstr ""

#. comic435 panel p2
#. slot: middle bubble
#. images: thought.gif, bogeytwalk2.gif, sheenamwalk2.gif
#: kidradd/comic435.htm:146
msgctxt "comic435#p2.2"
msgid "Just one quick hug!"
msgstr ""

#. comic435 panel p2
#. slot: right bubble
#. images: thought.gif, bogeytwalk2.gif, sheenamwalk2.gif
#: kidradd/comic435.htm:148
msgctxt "comic435#p2.3"
msgid "No!"
msgstr ""

#. comic435 panel p4
#. slot: left bubble
#. images: bogeyask.gif, sheenafume2.gif
#: kidradd/comic435.htm:227
msgctxt "comic435#p4.1"
msgid "Uh, do you mind if I ask?..."
msgstr ""

#. comic435 panel p4
#. slot: middle bubble
#. images: bogeyask.gif, sheenafume2.gif
#: kidradd/comic435.htm:229
msgctxt "comic435#p4.2"
msgid "Yes, I do!"
msgstr ""

#. comic435 panel p4
#. slot: right bubble
#. images: bogeyask.gif, sheenafume2.gif
#: kidradd/comic435.htm:231
msgctxt "comic435#p4.3"
msgid "..And then we'll go on the bumper cars, teehee!"
msgstr ""

#. comic436 panel title
#. slot: background color and image
#: kidradd/comic436.htm:47
msgctxt "comic436#title.1"
msgid "\"CHILD OF VISION\""
msgstr ""

#. comic436 panel p1
#. slot: left bubble
#: kidradd/comic436.htm:88
msgctxt "comic436#p1.1"
msgid "Let's see, we gotta climb two more rooms north to find that Nurse."
msgstr ""

#. comic436 panel p1
#. slot: right bubble
#: kidradd/comic436.htm:92
msgctxt "comic436#p1.2"
msgid "Fine, let's get this over with."
msgstr ""

#. comic436 panel p2
#. slot: left bubble
#. images: bogeystare2.gif, sheenablink2.gif
#: kidradd/comic436.htm:143
msgctxt "comic436#p2.1"
msgid "You're not having a good day, are you?"
msgstr ""

#. comic436 panel p2
#. slot: right bubble
