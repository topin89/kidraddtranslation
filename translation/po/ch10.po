#. comic162 panel title
#. slot: background color and image
#: kidradd/comic162.htm:35
msgctxt "comic162#title.1"
msgid "\"IN YOUR EYES\""
msgstr ""

#. comic162 panel p1
#. slot: middle bubble
#: kidradd/comic162.htm:78
msgctxt "comic162#p1.1"
msgid "<font size=\"2\" face=\"arial\" color=\"blue\">Go away; let me rest in peace.</font><br><br><font size=\"2\" face=\"arial\" color=\"green\">Geez, you're a crybaby.</font>"
msgstr ""

#. comic162 panel p2
#. slot: middle bubble
#: kidradd/comic162.htm:133
msgctxt "comic162#p2.1"
msgid "<font size=\"2\" face=\"arial\" color=\"blue\">Bogey? You're here too?</font><br><br><font size=\"2\" face=\"arial\" color=\"green\">Yes. Why is that surprising?</font>"
msgstr ""

#. comic162 panel p3
#. slot: middle bubble
#: kidradd/comic162.htm:186
msgctxt "comic162#p3.1"
msgid "<font size=\"2\" face=\"arial\" color=\"blue\">Well, since I'm dead and all...</font><br><br><font size=\"2\" face=\"arial\" color=\"green\">What? Dead? You're not dead.</font>"
msgstr ""

#. comic162 panel p4
#. slot: middle bubble
#: kidradd/comic162.htm:237
msgctxt "comic162#p4.1"
msgid "<font size=\"2\" face=\"arial\" color=\"blue\">Then why can't I see you?</font><br><br><font size=\"2\" face=\"arial\" color=\"green\">Because your eyes are closed, moron.</font>"
msgstr ""

#. comic162 panel p5
#. slot: left bubble
#. images: raddtcurl.gif, amp.gif, bogeysigh2.gif, sheenastand2.gif
#: kidradd/comic162.htm:290
