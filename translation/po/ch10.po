msgstr ""

#. comic162 panel p5
#. slot: middle bubble
#. images: raddtcurl.gif, amp.gif, bogeysigh2.gif, sheenastand2.gif
#: kidradd/comic162.htm:292
msgctxt "comic162#p5.2"
