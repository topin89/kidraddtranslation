msgstr ""

#. comic162 panel p5
#. slot: right bubble
#. images: raddtcurl.gif, amp.gif, bogeysigh2.gif, sheenastand2.gif
#: kidradd/comic162.htm:294
msgctxt "comic162#p5.3"
msgid "You have no idea..."
msgstr ""

#. comic163 panel title
#. slot: background color and image
#: kidradd/comic163.htm:36
msgctxt "comic163#title.1"
msgid "\"AND SO THIS IS CHRISTMAS?\""
msgstr ""

#. comic163 panel p1
#. slot: middle bubble
#. images: raddstare.gif
#: kidradd/comic163.htm:79
msgctxt "comic163#p1.1"
msgid "Hi everyone. I've just been informed that we need to interrupt the story to wish you all happiness and whatever during your odd human-world holidays."
msgstr ""

#. comic163 panel p2
#. slot: narration (if any, else cut)
#. images: raddblink.gif
#: kidradd/comic163.htm:127
msgctxt "comic163#p2.1"
msgid "Just read the script, Radd."
msgstr ""

#. comic163 panel p2
#. slot: middle bubble
#. images: raddblink.gif
#: kidradd/comic163.htm:135
msgctxt "comic163#p2.2"
msgid "Sorry. Ahem, Merry Christmas and may Santa bring you lots of presents. Ho, ho... ho?"
msgstr ""

#. comic163 panel p3
#. slot: left bubble
#. images: menorah.gif, bogeystand2.gif
#: kidradd/comic163.htm:185
msgctxt "comic163#p3.1"
msgid "To our Jewish friends we wish a very belated Happy Ch-? Chanukah? Shalom? Did I say that right?"
msgstr ""

#. comic163 panel p4
#. slot: left bubble
#. images: barkeep2.gif
#: kidradd/comic163.htm:237
msgctxt "comic163#p4.1"
msgid "As Hopetown's most successful restauranteur and the strip's only black character, let me wish you a festive Kwanzaa celebration."
msgstr ""

#. comic163 panel p5
#. slot: left bubble
#. images: barkeep3.gif, raddstand2.gif, bogeyupt2.gif, sheenamad2.gif
#: kidradd/comic163.htm:290
msgctxt "comic163#p5.1"
msgid "What's \"black?\""
msgstr ""

#. comic163 panel p5
#. slot: middle bubble
#. images: barkeep3.gif, raddstand2.gif, bogeyupt2.gif, sheenamad2.gif
#: kidradd/comic163.htm:292
msgctxt "comic163#p5.2"
msgid "I dunno. Does this \"Christmas\" really involve three \"ho's?\""
msgstr ""

#. comic163 panel p5
#. slot: right bubble
#. images: barkeep3.gif, raddstand2.gif, bogeyupt2.gif, sheenamad2.gif
#: kidradd/comic163.htm:294
msgctxt "comic163#p5.3"
msgid "Damn, I hope so."
msgstr ""

#. comic164 panel title
#. slot: background color and image
#: kidradd/comic164.htm:35
msgctxt "comic164#title.1"
msgid "\"CATCH ME IF YOU CAN\""
msgstr ""

#. comic164 panel p1
#. slot: left bubble
#. images: raddtcurl.gif, amp2.gif, bogeystand2.gif, sheenastand2.gif
#: kidradd/comic164.htm:76
msgctxt "comic164#p1.1"
msgid "How did I get here?"
msgstr ""

#. comic164 panel p1
#. slot: middle bubble
#. images: raddtcurl.gif, amp2.gif, bogeystand2.gif, sheenastand2.gif
#: kidradd/comic164.htm:78
msgctxt "comic164#p1.2"
msgid "Your little green friend saved you."
msgstr ""

#. comic164 panel p2
#. slot: left bubble
#. images: raddstand.gif, amp2.gif, bogeymad2.gif, sheenastand2.gif
#: kidradd/comic164.htm:131
msgctxt "comic164#p2.1"
msgid "Bogey?"
msgstr ""

#. comic164 panel p2
#. slot: right bubble
#. images: raddstand.gif, amp2.gif, bogeymad2.gif, sheenastand2.gif
#: kidradd/comic164.htm:135
msgctxt "comic164#p2.2"
msgid "Yeah, against my better judgment."
msgstr ""

#. comic164 panel p3
#. slot: narration (if any, else cut)
#. images: tv.gif, bogeyyell2.gif
#: kidradd/comic164.htm:180
msgctxt "comic164#p3.1"
msgid "\"Today was my turn to host the Fraternal Order of Bogeys meeting, and I came home to find my apartment a disaster area.\""
msgstr ""

#. comic164 panel p4
#. slot: narration (if any, else cut)
#. images: bogeyrun2.gif
#: kidradd/comic164.htm:233
msgctxt "comic164#p4.1"
msgid "\"Furious because my friends would arrive soon, I ran out to demand that it be cleaned up. Since the diner's just about the only place the perpetrator goes, I naturally headed over there.\""
msgstr ""

#. comic164 panel p5
#. slot: left bubble
#. images: raddstand.gif, amp.gif, bogeymad2.gif, sheenastand2.gif
#: kidradd/comic164.htm:294
msgctxt "comic164#p5.1"
msgid "Did you catch the jerk?"
msgstr ""

#. comic164 panel p5
#. slot: middle bubble
#. images: raddstand.gif, amp.gif, bogeymad2.gif, sheenastand2.gif
#: kidradd/comic164.htm:296
msgctxt "comic164#p5.2"
msgid "I'm talking about you, dimwit!"
msgstr ""

#. comic164 panel p5
#. slot: right bubble
#. images: raddstand.gif, amp.gif, bogeymad2.gif, sheenastand2.gif
#: kidradd/comic164.htm:298
msgctxt "comic164#p5.3"
msgid "Please, just continue."
msgstr ""

#. comic165 panel title
#. slot: background color and image
#: kidradd/comic165.htm:56
msgctxt "comic165#title.1"
msgid "\"KUNG-FU FIGHTING\""
msgstr ""

#. comic165 panel p1
#. slot: narration (if any, else cut)
#. images: raddleft.gif, shady.gif, bogeystand2.gif
#: kidradd/comic165.htm:93
msgctxt "comic165#p1.1"
msgid "\"So when I get to the diner, I find Radd concluding some business with some weirdo. The shady guy follows Radd after they're done, so I decided to tail them both.\""
msgstr ""

#. comic165 panel p2
#. slot: narration (if any, else cut)
#. images: bogeymad.gif, scramble3.gif, shady.gif
#: kidradd/comic165.htm:151
msgctxt "comic165#p2.1"
msgid "\"Before I know it, Radd's somehow incapacitated and that weirdo's attacking him. That's when I stepped in.\""
msgstr ""

#. comic165 panel p3
#. slot: insert ground "tiles" on this line
#: kidradd/comic165.htm:223
msgctxt "comic165#p3.1"
msgid "The rotation was supposed to be Matrix-ish, but it looks like they're do-si-do-ing."
msgstr ""

#. comic165 panel p4
#. slot: left bubble
#. images: raddstand.gif, amp.gif, bogeystand.gif, sheenamad2.gif
#: kidradd/comic165.htm:262
msgctxt "comic165#p4.1"
msgid "Whoa."
msgstr ""

#. comic165 panel p4
#. slot: right bubble
#. images: raddstand.gif, amp.gif, bogeystand.gif, sheenamad2.gif
#: kidradd/comic165.htm:266
msgctxt "comic165#p4.2"
msgid "Wait a second. You expect us to believe that you clobbered the suspect with a flying kick?"
msgstr ""

#. comic165 panel p5
#. slot: narration (if any, else cut)
#. images: raddcurl2.gif, sidewalk.gif
#: kidradd/comic165.htm:313
msgctxt "comic165#p5.1"
msgid "\"Well, something like that.\""
msgstr ""

#. comic166 panel title
#. slot: background color and image
#: kidradd/comic166.htm:35
msgctxt "comic166#title.1"
msgid "\"I JUST WANNA THANK YOU\""
msgstr ""

#. comic166 panel p1
#. slot: left bubble
#. images: raddstand.gif, amp2.gif, bogeystand2.gif, sheenastand2.gif
#: kidradd/comic166.htm:76
msgctxt "comic166#p1.1"
msgid "Then what happened?"
msgstr ""

#. comic166 panel p1
#. slot: right bubble
#. images: raddstand.gif, amp2.gif, bogeystand2.gif, sheenastand2.gif
#: kidradd/comic166.htm:80
msgctxt "comic166#p1.2"
msgid "You were in pretty bad shape when Bogey called, but I hoped Dr. Amp could help."
msgstr ""

#. comic166 panel p2
#. slot: right bubble
#. images: raddtable.gif, amptable2.gif
#: kidradd/comic166.htm:135
msgctxt "comic166#p2.1"
msgid "So your friends brought you here and I removed the damaged line of code from you. Just in time, I might add; you had them both worried sick."
msgstr ""

#. comic166 panel p3
#. slot: left bubble
#. images: raddstand.gif, amp2.gif, bogeystand2.gif, sheenasmug2.gif
#: kidradd/comic166.htm:183
msgctxt "comic166#p3.1"
msgid "Wow Bogey, I - I can't thank you enough. And Sheena, well, it's great to know that you really do care."
msgstr ""

#. comic166 panel p3
#. slot: right bubble
#. images: raddstand.gif, amp2.gif, bogeystand2.gif, sheenasmug2.gif
#: kidradd/comic166.htm:187
msgctxt "comic166#p3.2"
msgid "Aw, gee. Thats what friends are for."
msgstr ""

#. comic166 panel p4
#. slot: right bubble
