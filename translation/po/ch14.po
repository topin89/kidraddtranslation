#. comic223 panel p3
#. slot: left bubble
#. images: raddblink.gif
#: kidradd/comic223.htm:203
#, fuzzy
msgctxt "comic223#p3.1"
msgid "Hey, Bogeyman! Where are ya?"
msgstr "Эй, Бяка-бука! Ты где?"

#. comic223 panel p3
#. slot: right bubble
#. images: raddblink.gif
#: kidradd/comic223.htm:207
#, fuzzy
msgctxt "comic223#p3.2"
msgid "Wha?... It's like 3am..."
msgstr "Чего?.. Три часа ночи же..."

#. comic223 panel p4
#. slot: left bubble
#. images: raddstand.gif, sprout.gif
#: kidradd/comic223.htm:258
#, fuzzy
msgctxt "comic223#p4.1"
