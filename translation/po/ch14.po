#. comic223 panel p5
#. slot: right bubble
#. images: raddblink.gif, madsprout.gif
#: kidradd/comic223.htm:316
#, fuzzy
msgctxt "comic223#p5.2"
msgid "Very funny, Beavis. Now go back to bed."
msgstr "Очень смешно, Бивис. А теперь марш в кровать."

#. comic224 panel title
#. slot: background color and image
#: kidradd/comic224.htm:34
#, fuzzy
msgctxt "comic224#title.1"
