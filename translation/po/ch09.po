#: kidradd/comic123.htm:36
msgctxt "comic123#title.1"
msgid "\"BREAKING THE LAW\""
msgstr ""

#. comic123 panel p1
#. slot: left bubble
#. images: raddright.gif, shady.gif
#: kidradd/comic123.htm:77
msgctxt "comic123#p1.1"
