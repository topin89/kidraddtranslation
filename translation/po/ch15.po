#. comic241 panel title
#. slot: background color and image
#: kidradd/comic241.htm:35
msgctxt "comic241#title.1"
msgid "\"TOO MUCH TIME ON MY HANDS\""
msgstr ""

#. comic241 panel p1
#. slot: left bubble
#. images: sheenaback2.gif
#: kidradd/comic241.htm:76
msgctxt "comic241#p1.1"
msgid "Being unable to do anything is so depressing... I wonder how the others are holding out?"
msgstr ""

#. comic241 panel p2
#. slot: left bubble
#. images: bogeyargh2.gif
#: kidradd/comic241.htm:132
msgctxt "comic241#p2.1"
msgid "I have no job and nothing to do. I think I'm gonna go nuts!"
msgstr ""

#. comic241 panel p3
#. slot: right bubble
#. images: raddblink.gif
#: kidradd/comic241.htm:187
msgctxt "comic241#p3.1"
msgid "I have no job and nothing to do. Awesome!"
msgstr ""

#. comic241 panel p4
#. slot: left bubble
#. images: ampmic.gif, pred1.gif, microscope.gif
#: kidradd/comic241.htm:235
msgctxt "comic241#p4.1"
msgid "I have no job and nothing to do. I guess I'll build some weapons of mass destruction."
msgstr ""

#. comic241 panel p5
#. slot: left bubble
#. images: juliefglad2.gif
#: kidradd/comic241.htm:289
msgctxt "comic241#p5.1"
msgid "La dee da... La dee deeeee dee da...<br><i>hee-hee.</i>"
msgstr ""

#. comic242 panel title
#. slot: background color and image
#: kidradd/comic242.htm:34
msgctxt "comic242#title.1"
msgid "\"WALKING ON SUNSHINE\""
msgstr ""

#. comic242 panel p1
#. slot: left bubble
#. images: raddright.gif
#: kidradd/comic242.htm:75
msgctxt "comic242#p1.1"
msgid "Bogey? Are you in here?"
msgstr ""

#. comic242 panel p1
#. slot: right bubble
#. images: raddright.gif
#: kidradd/comic242.htm:79
msgctxt "comic242#p1.2"
msgid "Yeah, come in."
msgstr ""

#. comic242 panel p2
#. slot: left bubble
#. images: raddstand.gif, bogeypot.gif
#: kidradd/comic242.htm:132
msgctxt "comic242#p2.1"
msgid "Oh, um... yeah."
msgstr ""

#. comic242 panel p2
#. slot: right bubble
#. images: raddstand.gif, bogeypot.gif
#: kidradd/comic242.htm:136
msgctxt "comic242#p2.2"
msgid "What?"
msgstr ""

#. comic242 panel p3
#. slot: left bubble
#. images: raddright.gif, bogeypot.gif
#: kidradd/comic242.htm:184
msgctxt "comic242#p3.1"
msgid "Are you, uh, feeling alright?"
msgstr ""

#. comic242 panel p3
#. slot: right bubble
#. images: raddright.gif, bogeypot.gif
#: kidradd/comic242.htm:188
msgctxt "comic242#p3.2"
msgid "This is just my way of relaxing, okay? You should try it."
msgstr ""

#. comic242 panel p4
#. slot: left bubble
#. images: raddblink.gif, bogeypot.gif
#: kidradd/comic242.htm:238
msgctxt "comic242#p4.1"
msgid "No thanks. I don't dig enemy sprite stuff."
msgstr ""

#. comic242 panel p4
#. slot: right bubble
#. images: raddblink.gif, bogeypot.gif
#: kidradd/comic242.htm:242
msgctxt "comic242#p4.2"
msgid "Your loss. I hear Sheena does."
msgstr ""

#. comic242 panel p5
#. slot: left bubble
#. images: raddpot.gif
#: kidradd/comic242.htm:289
msgctxt "comic242#p5.1"
msgid "Hey, this <b>is</b> kinda fun."
msgstr ""

#. comic242 panel p5
#. slot: right bubble
#. images: raddpot.gif
#: kidradd/comic242.htm:293
msgctxt "comic242#p5.2"
msgid "Doesn't take much to sway you, huh?"
msgstr ""

#. comic243 panel title
#. slot: background color and image
#: kidradd/comic243.htm:35
msgctxt "comic243#title.1"
msgid "\"MOTORIN'\""
msgstr ""

#. comic243 panel p1
#. slot: right bubble
#. images: thought.gif, raddwalk2.gif
#: kidradd/comic243.htm:80
msgctxt "comic243#p1.1"
msgid "Hanging with Bogey is boring. Maybe I'll see what Amp is doing."
msgstr ""

#. comic243 panel p2
#. slot: left bubble
#. images: raddright.gif, sheenastand2.gif
#: kidradd/comic243.htm:132
msgctxt "comic243#p2.1"
msgid "Hey, where's Dr. Amp?"
msgstr ""

#. comic243 panel p2
#. slot: right bubble
#. images: raddright.gif, sheenastand2.gif
#: kidradd/comic243.htm:136
msgctxt "comic243#p2.2"
msgid "I think he's in his lab, making more guns or something."
msgstr ""

#. comic243 panel p3
#. slot: left bubble
#. images: raddsigh.gif, sheenasmug2.gif
#: kidradd/comic243.htm:183
msgctxt "comic243#p3.1"
msgid "Not again! That last one nearly killed me! Where's his lab?"
msgstr ""

#. comic243 panel p3
#. slot: right bubble
#. images: raddsigh.gif, sheenasmug2.gif
#: kidradd/comic243.htm:187
msgctxt "comic243#p3.2"
msgid "Oh, you gotta pass through the engine room, just at the end of the hall."
msgstr ""

#. comic243 panel p4
#. slot: right bubble
#. images: thought.gif, raddback.gif
#: kidradd/comic243.htm:239
msgctxt "comic243#p4.1"
msgid "Engine room? I guess I haven't been here yet, either..."
msgstr ""

#. comic243 panel p5
#. slot: left bubble
#. images: black.gif, raddwow2.gif
#: kidradd/comic243.htm:289
msgctxt "comic243#p5.1"
msgid "Holy bit!"
msgstr ""

#. comic244 panel title
#. slot: background color and image
#: kidradd/comic244.htm:35
msgctxt "comic244#title.1"
msgid "\"STRAP YOUR HANDS\""
msgstr ""

#. comic244 panel p1
#. slot: left bubble
#. images: raddwow.gif, amp2.gif
#: kidradd/comic244.htm:76
msgctxt "comic244#p1.1"
msgid "What the hell is this place?"
msgstr ""

#. comic244 panel p1
#. slot: right bubble
#. images: raddwow.gif, amp2.gif
#: kidradd/comic244.htm:80
msgctxt "comic244#p1.2"
msgid "Oh, hi Radd. Welcome to the engine room."
msgstr ""

#. comic244 panel p2
#. slot: left bubble
#. images: raddtablem.gif, amptable2.gif
#: kidradd/comic244.htm:133
msgctxt "comic244#p2.1"
msgid "You power this ship with puzzle sprites???"
msgstr ""

#. comic244 panel p2
#. slot: right bubble
#. images: raddtablem.gif, amptable2.gif
#: kidradd/comic244.htm:137
msgctxt "comic244#p2.2"
msgid "Of course. They're all the free power we'll ever need, and they love it."
msgstr ""

#. comic244 panel p3
#. slot: left bubble
#. images: raddback.gif, amp2.gif
#: kidradd/comic244.htm:183
msgctxt "comic244#p3.1"
msgid "That's kinda messed up, though."
msgstr ""

#. comic244 panel p3
#. slot: right bubble
#. images: raddback.gif, amp2.gif
#: kidradd/comic244.htm:187
msgctxt "comic244#p3.2"
msgid "They gave me the idea to name the ship the \"High Score.\""
msgstr ""

#. comic244 panel p4
#. slot: left bubble
#. images: raddstand.gif, amp2.gif
#: kidradd/comic244.htm:235
msgctxt "comic244#p4.1"
msgid "Correction, <b>that's</b> messed up."
msgstr ""

#. comic244 panel p4
#. slot: right bubble
#. images: raddstand.gif, amp2.gif
#: kidradd/comic244.htm:239
msgctxt "comic244#p4.2"
msgid "It was either that or the \"Bonus Round.\""
msgstr ""

#. comic245 panel title
#. slot: background color and image
#: kidradd/comic245.htm:35
msgctxt "comic245#title.1"
msgid "\"DREAM WEAVER\""
msgstr ""

#. comic245 panel p1
#. slot: narration (if any, else cut)
#. images: thought.gif, sheenaslp.gif
#: kidradd/comic245.htm:72
msgctxt "comic245#p1.1"
msgid "That night, Sheena's sleep is far from peaceful."
msgstr ""

#. comic245 panel p1
#. slot: middle bubble
#. images: thought.gif, sheenaslp.gif
#: kidradd/comic245.htm:80
msgctxt "comic245#p1.2"
msgid "Go... away..."
msgstr ""

#. comic245 panel p2
#. slot: middle bubble
#. images: sheenaslp2.gif
#: kidradd/comic245.htm:136
msgctxt "comic245#p2.1"
msgid "<font size=\"2\" face=\"arial\" color=\"DF31FF\">This one has a riddle!</font><br><br><font size=\"2\" face=\"arial\" color=\"A531FF\">We like riddles! We do!</font>"
msgstr ""

#. comic245 panel p3
#. slot: middle bubble
#. images: sheenaslp3.gif
#: kidradd/comic245.htm:187
msgctxt "comic245#p3.1"
msgid "<font size=\"2\" face=\"arial\" color=\"DF31FF\">She really needs to visit us. It will make the future less boring!</font><br><font size=\"2\" face=\"arial\" color=\"A531FF\">Yes, if she visits us, the future's path will change greatly.</font>"
msgstr ""

#. comic245 panel p4
#. slot: middle bubble
#. images: sheenaslp4.gif
#: kidradd/comic245.htm:239
msgctxt "comic245#p4.1"
msgid "<font size=\"2\" face=\"arial\" color=\"DF31FF\">Indeed, it may change so much that even we can't predict it!</font><br><br><font size=\"2\" face=\"arial\" color=\"A531FF\">Oh, what fun that would be!</font>"
msgstr ""

#. comic245 panel p5
#. slot: middle bubble
#. images: sheenabed.gif
#: kidradd/comic245.htm:291
msgctxt "comic245#p5.1"
msgid "Oh no. That <b>can't</b> be the answer..."
msgstr ""

#. comic246 panel title
#. slot: background color and image
#: kidradd/comic246.htm:51
msgctxt "comic246#title.1"
msgid "\"THE WALL\""
msgstr ""

#. comic246 panel p1
#. slot: left bubble
#. images: sheenablink.gif, bogeytalk2.gif
#: kidradd/comic246.htm:92
msgctxt "comic246#p1.1"
msgid "Bogey, I think I know what we need to do."
msgstr ""

#. comic246 panel p1
#. slot: right bubble
#. images: sheenablink.gif, bogeytalk2.gif
#: kidradd/comic246.htm:96
msgctxt "comic246#p1.2"
msgid "One moment Sheena, I'm busy. Now, Radd!"
msgstr ""

#. comic246 panel p2
#. slot: narration (if any, else cut)
#. images: point.gif
#: kidradd/comic246.htm:145
msgctxt "comic246#p2.1"
msgid "CHARRRGE!!!"
msgstr ""

#. comic246 panel p3
#. slot: left bubble
#. images: raddhall2.gif
#: kidradd/comic246.htm:203
msgctxt "comic246#p3.1"
msgid "I <b>told</b> ya you couldn't crack the wall with your head! Now pay up!"
msgstr ""

#. comic246 panel p3
#. slot: right bubble
#. images: raddhall2.gif
#: kidradd/comic246.htm:207
msgctxt "comic246#p3.2"
msgid "Aw man..."
msgstr ""

#. comic246 panel p4
#. slot: left bubble
#. images: raddhall3.gif
#: kidradd/comic246.htm:257
msgctxt "comic246#p4.1"
msgid "You guys definitely need to get off this ship."
msgstr ""

#. comic246 panel p4
#. slot: middle bubble
#. images: raddhall3.gif
#: kidradd/comic246.htm:259
msgctxt "comic246#p4.2"
msgid "Next, I bet ya can't crack the power conduit!"
msgstr ""

#. comic246 panel p4
#. slot: right bubble
#. images: raddhall3.gif
#: kidradd/comic246.htm:261
msgctxt "comic246#p4.3"
msgid "You're on!"
msgstr ""

#. comic247 panel title
#. slot: background color and image
#: kidradd/comic247.htm:34
msgctxt "comic247#title.1"
msgid "\"SAY WHAT?\""
msgstr ""

#. comic247 panel p1
#. slot: left bubble
#. images: raddchair.gif, bogeyup.gif, sheenastand2.gif
#: kidradd/comic247.htm:75
msgctxt "comic247#p1.1"
msgid "Okay, here's my plan to stop our cycle of endless wandering and running from the Mods."
msgstr ""

#. comic247 panel p2
#. slot: left bubble
#. images: chead.gif, sheenaleft.gif
#: kidradd/comic247.htm:132
msgctxt "comic247#p2.1"
msgid "As you may the recall, the Mods' unofficial leader Crystal is pursuing ultimate power. She's doing this via some mysterious advice she learned from the Seer."
msgstr ""

#. comic247 panel p3
#. slot: left bubble
#. images: raddtablem.gif, bogeytabled.gif, sheenatable2.gif
#: kidradd/comic247.htm:184
msgctxt "comic247#p3.1"
msgid "Wait, the Seer? That oracle who answers anything, but everyone who visits him somehow turns up dead?"
msgstr ""

#. comic247 panel p3
#. slot: right bubble
#. images: raddtablem.gif, bogeytabled.gif, sheenatable2.gif
#: kidradd/comic247.htm:188
msgctxt "comic247#p3.2"
msgid "Yeah, that's the one."
msgstr ""

#. comic247 panel p4
#. slot: left bubble
#. images: raddtable3.gif, bogeytabled.gif, sheenatable2.gif
#: kidradd/comic247.htm:237
msgctxt "comic247#p4.1"
msgid "Man, I'd hate to go anywhere near that guy. So what's your plan?"
msgstr ""

#. comic247 panel p4
#. slot: right bubble
#. images: raddtable3.gif, bogeytabled.gif, sheenatable2.gif
#: kidradd/comic247.htm:241
msgctxt "comic247#p4.2"
msgid "We're going to visit him."
msgstr ""

#. comic247 panel p5
#. slot: left bubble
#. images: raddtable.gif, bogeytabledd.gif, sheenatablem2.gif
#: kidradd/comic247.htm:287
msgctxt "comic247#p5.1"
msgid "Heh. And I thought I was the stupid one here."
msgstr ""

#. comic247 panel p5
#. slot: middle bubble
#. images: raddtable.gif, bogeytabledd.gif, sheenatablem2.gif
#: kidradd/comic247.htm:289
msgctxt "comic247#p5.2"
msgid "Don't worry, you still are."
msgstr ""

#. comic247 panel p5
#. slot: right bubble
#. images: raddtable.gif, bogeytabledd.gif, sheenatablem2.gif
#: kidradd/comic247.htm:291
msgctxt "comic247#p5.3"
msgid "Guys, this is serious!"
msgstr ""

#. comic248 panel title
#. slot: background color and image
#: kidradd/comic248.htm:34
msgctxt "comic248#title.1"
msgid "\"FOOL'S CHANCE\""
msgstr ""

#. comic248 panel p1
#. slot: left bubble
#. images: raddtablem.gif, bogeytabled.gif, sheenatable2.gif
#: kidradd/comic248.htm:75
msgctxt "comic248#p1.1"
msgid "Sorry Sheena, but there's no way I'm talking to the Seer."
msgstr ""

#. comic248 panel p1
#. slot: middle bubble
#. images: raddtablem.gif, bogeytabled.gif, sheenatable2.gif
#: kidradd/comic248.htm:77
msgctxt "comic248#p1.2"
msgid "Regretfully, I'm inclined to agree."
msgstr ""

#. comic248 panel p1
#. slot: right bubble
#. images: raddtablem.gif, bogeytabled.gif, sheenatable2.gif
#: kidradd/comic248.htm:79
msgctxt "comic248#p1.3"
msgid "But you guys wouldn't."
msgstr ""

#. comic248 panel p2
#. slot: left bubble
#. images: sheenafront2.gif
#: kidradd/comic248.htm:131
msgctxt "comic248#p2.1"
msgid "<b>I</b> would. It's my idea, so I'll take the risk. It needs to be done."
msgstr ""

#. comic248 panel p3
#. slot: left bubble
#. images: raddtablen.gif, bogeytablen.gif, sheenatableb2.gif
#: kidradd/comic248.htm:183
msgctxt "comic248#p3.1"
msgid "But Sheena..."
msgstr ""

#. comic248 panel p3
#. slot: middle bubble
#. images: raddtablen.gif, bogeytablen.gif, sheenatableb2.gif
#: kidradd/comic248.htm:185
msgctxt "comic248#p3.2"
msgid "Don't throw your life away!"
msgstr ""

#. comic248 panel p3
#. slot: right bubble
#. images: raddtablen.gif, bogeytablen.gif, sheenatableb2.gif
#: kidradd/comic248.htm:187
msgctxt "comic248#p3.3"
msgid "Oh, I won't! Really."
msgstr ""

#. comic248 panel p4
#. slot: left bubble
#. images: raddtable.gif, bogeytabled.gif, sheenatable2.gif
#: kidradd/comic248.htm:236
msgctxt "comic248#p4.1"
msgid "I'm an invincible NPC, remember? There's no way a contrived, monkey's paw style accident can kill me! I'll be just fine!"
msgstr ""

#. comic248 panel p5
#. slot: middle bubble
#. images: thought2.gif, sheadsad.gif
#: kidradd/comic248.htm:288
msgctxt "comic248#p5.1"
msgid "...I think."
msgstr ""

#. comic249 panel title
#. slot: background color and image
#: kidradd/comic249.htm:34
msgctxt "comic249#title.1"
msgid "\"TROUBLE YOURSELF NOT\""
msgstr ""

#. comic249 panel p1
#. slot: left bubble
#. images: raddtable.gif, bogeytablen.gif, sheenatabled2.gif
#: kidradd/comic249.htm:75
msgctxt "comic249#p1.1"
msgid "I dunno, Sheena..."
msgstr ""

#. comic249 panel p1
#. slot: middle bubble
#. images: raddtable.gif, bogeytablen.gif, sheenatabled2.gif
#: kidradd/comic249.htm:77
msgctxt "comic249#p1.2"
msgid "Do you really want to go through with this?"
msgstr ""

#. comic249 panel p1
#. slot: right bubble
#. images: raddtable.gif, bogeytablen.gif, sheenatabled2.gif
#: kidradd/comic249.htm:79
msgctxt "comic249#p1.3"
msgid "It's truly our only option."
msgstr ""

#. comic249 panel p2
#. slot: left bubble
#. images: sheenafront2.gif
#: kidradd/comic249.htm:131
msgctxt "comic249#p2.1"
msgid "If there's any way at all for us to stop the Mods, the Seer is the only one who knows it. And we <b>have</b> to find out, for everyone's sake."
msgstr ""

#. comic249 panel p3
#. slot: left bubble
#. images: raddtable.gif, bogeytabled.gif, sheenatable2.gif
#: kidradd/comic249.htm:183
msgctxt "comic249#p3.1"
msgid "I guess it's settled, then. I'll tell Amp to take us to the Seer."
msgstr ""

#. comic249 panel p3
#. slot: right bubble
#. images: raddtable.gif, bogeytabled.gif, sheenatable2.gif
#: kidradd/comic249.htm:187
msgctxt "comic249#p3.2"
msgid "That's okay, I already told him. We'll be there any minute now."
msgstr ""

#. comic249 panel p4
#. slot: left bubble
#. images: raddtableargh.gif, bogeytabledd2.gif, sheenatableb2.gif
#: kidradd/comic249.htm:236
msgctxt "comic249#p4.1"
msgid "WHAT?"
msgstr ""

#. comic249 panel p4
#. slot: middle bubble
#. images: raddtableargh.gif, bogeytabledd2.gif, sheenatableb2.gif
#: kidradd/comic249.htm:238
msgctxt "comic249#p4.2"
msgid "You could have pretended this was a group decision."
msgstr ""

#. comic249 panel p4
#. slot: right bubble
#. images: raddtableargh.gif, bogeytabledd2.gif, sheenatableb2.gif
#: kidradd/comic249.htm:240
msgctxt "comic249#p4.3"
msgid "It was - retroactively."
msgstr ""

#. comic250 panel title
#. slot: background color and image
#: kidradd/comic250.htm:34
msgctxt "comic250#title.1"
msgid "\"MILES AND MILES\""
msgstr ""

#. comic250 panel p1
#. slot: left bubble
#. images: ship.gif
#: kidradd/comic250.htm:75
msgctxt "comic250#p1.1"
msgid "Whoa. Netspace looks different."
msgstr ""

#. comic250 panel p1
#. slot: right bubble
#. images: ship.gif
#: kidradd/comic250.htm:79
msgctxt "comic250#p1.2"
msgid "The datastream is much sparser here."
msgstr ""

#. comic250 panel p2
#. slot: left bubble
#. images: bogeystand.gif, sheenastand.gif, ampstand.gif, raddstand2.gif, julie2.gif
#: kidradd/comic250.htm:133
msgctxt "comic250#p2.1"
msgid "We're near the Seer's, um, place. Everything here is messed up."
msgstr ""

#. comic250 panel p2
#. slot: right bubble
#. images: bogeystand.gif, sheenastand.gif, ampstand.gif, raddstand2.gif, julie2.gif
#: kidradd/comic250.htm:137
msgctxt "comic250#p2.2"
msgid "\"Messed up?\" That doesn't sound very scientific."
msgstr ""

#. comic250 panel p3
#. slot: left bubble
#. images: ampstand.gif, raddstand2.gif
#: kidradd/comic250.htm:185
msgctxt "comic250#p3.1"
msgid "Well, I could try Star Trek-style technobabble if you like, but I'm not too good at that."
msgstr ""

#. comic250 panel p3
#. slot: right bubble
#. images: ampstand.gif, raddstand2.gif
#: kidradd/comic250.htm:189
msgctxt "comic250#p3.2"
msgid "Nevermind, I'll settle for messed up."
msgstr ""

#. comic250 panel p4
#. slot: left bubble
#. images: seerspace.gif, ship4.gif
#: kidradd/comic250.htm:238
msgctxt "comic250#p4.1"
msgid "There it is..."
msgstr ""

#. comic250 panel p4
#. slot: right bubble
#. images: seerspace.gif, ship4.gif
#: kidradd/comic250.htm:242
msgctxt "comic250#p4.2"
msgid "Damn."
msgstr ""

#. comic251 panel title
#. slot: background color and image
#: kidradd/comic251.htm:51
msgctxt "comic251#title.1"
msgid "\"SAY GOODBYE\""
msgstr ""

#. comic251 panel p1
#. slot: left bubble
#: kidradd/comic251.htm:92
msgctxt "comic251#p1.1"
msgid "I can't believe you're gonna walk in this - thing. It looks alive."
msgstr ""

#. comic251 panel p1
#. slot: middle bubble
#: kidradd/comic251.htm:94
msgctxt "comic251#p1.2"
msgid "I won't take long. I'm ready to go, Dr. Amp."
msgstr ""

#. comic251 panel p2
#. slot: narration (if any, else cut)
#. images: cargobye.gif
#: kidradd/comic251.htm:145
msgctxt "comic251#p2.1"
msgid "'PORTING SHEENA IN 3, 2, 1..."
msgstr ""

#. comic251 panel p2
#. slot: left bubble
#. images: cargobye.gif
#: kidradd/comic251.htm:151
msgctxt "comic251#p2.2"
msgid "Well, see ya soon, guys."
msgstr ""

#. comic251 panel p2
#. slot: middle bubble
#. images: cargobye.gif
#: kidradd/comic251.htm:153
msgctxt "comic251#p2.3"
msgid "Please be careful."
msgstr ""

#. comic251 panel p2
#. slot: right bubble
#. images: cargobye.gif
#: kidradd/comic251.htm:155
msgctxt "comic251#p2.4"
msgid "Yeah... Please."
msgstr ""

#. comic251 panel p3
#. slot: narration (if any, else cut)
#: kidradd/comic251.htm:199
msgctxt "comic251#p3.1"
msgid "TELEPORT!"
msgstr ""

#. comic251 panel p4
#. slot: right bubble
#. images: sheenastare.gif, bogeyyell2.gif, raddwow2.gif, stepsv.gif
#: kidradd/comic251.htm:263
msgctxt "comic251#p4.1"
msgid "What the -? Oh. I guess Dr. Amp made another little mistake, huh? Gee, it's almost funny."
msgstr ""

#. comic251 panel p5
#. slot: right bubble
