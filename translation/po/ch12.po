#. comic210 panel title
#. slot: background color and image
#: kidradd/comic210.htm:34
#, fuzzy
msgctxt "comic210#title.1"
msgid "\"A MATTER OF PRIDE\""
msgstr "«ДЕЛО ЧЕСТИ»"

#. comic210 panel p1
#. slot: left bubble
#. images: sheenatable.gif, amptable2.gif
#: kidradd/comic210.htm:75
#, fuzzy
msgctxt "comic210#p1.1"
msgid "Dr. Amp, we've got to leave this server immediately. Mods are on the way."
msgstr "Доктор Амп, нам надо немедленно покинуть этот сервер. Модеры уже в пути."

#. comic210 panel p1
#. slot: right bubble
#. images: sheenatable.gif, amptable2.gif
#: kidradd/comic210.htm:79
#, fuzzy
msgctxt "comic210#p1.2"
msgid "Understood."
