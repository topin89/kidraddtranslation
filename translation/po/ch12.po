#. comic190 panel p1
#. slot: narration (if any, else cut)
#. images: raddargh.gif
#: kidradd/comic190.htm:72
msgctxt "comic190#p1.1"
msgid "By now, saying Radd's gone stir crazy would be an understatement."
msgstr ""

#. comic190 panel p1
#. slot: right bubble
#. images: raddargh.gif
#: kidradd/comic190.htm:82
msgctxt "comic190#p1.2"
msgid "These four walls shall mock me no longer!"
msgstr ""

#. comic190 panel p2
#. slot: left bubble
#. images: raddfire.gif
#: kidradd/comic190.htm:134
msgctxt "comic190#p2.1"
msgid "These bogus barriers are coming down! Down I say!<br><b>Aaaarrrrgh!!!</b>"
msgstr ""

#. comic190 panel p3
#. slot: left bubble
#. images: charge.gif, cellwall.jpg
#: kidradd/comic190.htm:185
msgctxt "comic190#p3.1"
msgid "I'm <b>not</b> giving up! I'm getting out of here if it's the -"
msgstr ""

#. comic190 panel p4
#. slot: right bubble
#. images: raddaim.gif, celldoor.jpg
#: kidradd/comic190.htm:241
msgctxt "comic190#p4.1"
msgid "click!"
msgstr ""

#. comic190 panel p5
#. slot: left bubble
#. images: raddwow.gif, celldoor.jpg
#: kidradd/comic190.htm:290
msgctxt "comic190#p5.1"
msgid "- last thing I do?"
msgstr ""

#. comic190 panel p5
#. slot: imsert images on this line
#. images: raddwow.gif, celldoor.jpg
#: kidradd/comic190.htm:301
msgctxt "comic190#p5.2"
msgid "It could be..."
msgstr ""

#. comic191 panel title
#. slot: background color and image
#: kidradd/comic191.htm:35
msgctxt "comic191#title.1"
msgid "\"THE TEST\""
msgstr ""

#. comic191 panel p1
#. slot: left bubble
#. images: raddright.gif, celldoor.jpg
#: kidradd/comic191.htm:76
msgctxt "comic191#p1.1"
msgid "Who's out there? Am I being paroled?"
msgstr ""

#. comic191 panel p1
#. slot: imsert images on this line
#. images: raddright.gif, celldoor.jpg
#: kidradd/comic191.htm:87
msgctxt "comic191#p1.2"
msgid "Something like that..."
msgstr ""

#. comic191 panel p2
#. slot: left bubble
#. images: raddmad.gif, celldoor.jpg
#: kidradd/comic191.htm:132
msgctxt "comic191#p2.1"
msgid "Dammit, are ya gonna tell me what's going on?"
msgstr ""

#. comic191 panel p2
#. slot: imsert images on this line
#. images: raddmad.gif, celldoor.jpg
#: kidradd/comic191.htm:143
msgctxt "comic191#p2.2"
msgid "Come on out. We'll talk."
msgstr ""

#. comic191 panel p3
#. slot: right bubble
#. images: thought.gif, raddtablem.gif
#: kidradd/comic191.htm:187
msgctxt "comic191#p3.1"
msgid "Boy, it sure doesn't take a genius to notice that this smells funny. I'd better test this guy."
msgstr ""

#. comic191 panel p4
#. slot: left bubble
#. images: raddmad.gif, celldoor.jpg
#: kidradd/comic191.htm:234
msgctxt "comic191#p4.1"
msgid "Are you a Moderator?"
msgstr ""

#. comic191 panel p4
#. slot: imsert images on this line
#. images: raddmad.gif, celldoor.jpg
#: kidradd/comic191.htm:245
msgctxt "comic191#p4.2"
msgid "No."
msgstr ""

#. comic191 panel p5
#. slot: left bubble
#. images: raddwalk.gif, celldoor.jpg
#: kidradd/comic191.htm:287
msgctxt "comic191#p5.1"
msgid "Okay, good enough for me."
msgstr ""

#. comic192 panel title
#. slot: background color and image
#: kidradd/comic192.htm:48
msgctxt "comic192#title.1"
msgid "\"IS ANYBODY OUT THERE?\""
msgstr ""

#. comic192 panel p1
#. slot: narration (if any, else cut)
#. images: raddwalk.gif
#: kidradd/comic192.htm:85
msgctxt "comic192#p1.1"
msgid "Radd slowly exits his cell."
msgstr ""

#. comic192 panel p1
#. slot: left bubble
#. images: raddwalk.gif
#: kidradd/comic192.htm:91
msgctxt "comic192#p1.2"
msgid "Hello?"
msgstr ""

#. comic192 panel p2
#. slot: right bubble
#. images: raddmad.gif
#: kidradd/comic192.htm:151
msgctxt "comic192#p2.1"
msgid "Where the heck are you? Quit playing with me."
msgstr ""

#. comic192 panel p3
#. slot: right bubble
#. images: raddblink2.gif
#: kidradd/comic192.htm:203
msgctxt "comic192#p3.1"
msgid "You said we'd talk, so talk, dammit. Sheesh."
msgstr ""

#. comic192 panel p4
#. slot: middle bubble
#. images: raddfront.gif
#: kidradd/comic192.htm:255
msgctxt "comic192#p4.1"
msgid "Stupid coward."
msgstr ""

#. comic193 panel title
#. slot: background color and image
#: kidradd/comic193.htm:48
msgctxt "comic193#title.1"
msgid "\"NO\""
msgstr ""

#. comic193 panel p1
#. slot: middle bubble
#. images: monster.gif, raddbutt.gif
#: kidradd/comic193.htm:93
msgctxt "comic193#p1.1"
msgid "SON OF A BIT !!!!!"
msgstr ""

#. comic193 panel p2
#. slot: middle bubble
#. images: monster.gif, raddbutt.gif
#: kidradd/comic193.htm:151
msgctxt "comic193#p2.1"
msgid "Um, hi. Were you the voice I heard before?"
msgstr ""

#. comic193 panel p3
#. slot: middle bubble
#. images: monster.gif, raddbutt.gif
#: kidradd/comic193.htm:205
msgctxt "comic193#p3.1"
msgid "You let me out, so you're a friend, right?"
msgstr ""

#. comic193 panel p4
#. slot: middle bubble
#. images: raddbutt.gif
#: kidradd/comic193.htm:260
msgctxt "comic193#p4.1"
msgid "Crap."
msgstr ""

#. comic194 panel title
#. slot: background color and image
#: kidradd/comic194.htm:35
msgctxt "comic194#title.1"
msgid "\"KILLING MACHINE\""
msgstr ""

#. comic194 panel p1
#. slot: narration (if any, else cut)
#. images: monster2.gif, raddbutt.gif
#: kidradd/comic194.htm:72
msgctxt "comic194#p1.1"
msgid "I see you are suitably impressed, little man."
msgstr ""

#. comic194 panel p1
#. slot: middle bubble
#. images: monster2.gif, raddbutt.gif
#: kidradd/comic194.htm:80
msgctxt "comic194#p1.2"
msgid "Eh heh heh..."
msgstr ""

#. comic194 panel p2
#. slot: narration (if any, else cut)
#. images: monster2.gif, raddbutt.gif
#: kidradd/comic194.htm:130
msgctxt "comic194#p2.1"
msgid "But now you shall cower at my true visage."
msgstr ""

#. comic194 panel p2
#. slot: middle bubble
#. images: monster2.gif, raddbutt.gif
#: kidradd/comic194.htm:138
msgctxt "comic194#p2.2"
msgid "Oh boy."
msgstr ""

#. comic194 panel p3
#. slot: narration (if any, else cut)
#. images: raddbutt.gif
#: kidradd/comic194.htm:184
msgctxt "comic194#p3.1"
msgid "Behold! Deathbot 4999!"
msgstr ""

#. comic194 panel p4
#. slot: narration (if any, else cut)
#. images: raddback2.gif
#: kidradd/comic194.htm:239
msgctxt "comic194#p4.1"
msgid "Proceed with the cowering."
msgstr ""

#. comic194 panel p4
#. slot: middle bubble
#. images: raddback2.gif
#: kidradd/comic194.htm:247
msgctxt "comic194#p4.2"
msgid "I know I should be worried, but..."
msgstr ""

#. comic195 panel title
#. slot: background color and image
#: kidradd/comic195.htm:35
msgctxt "comic195#title.1"
msgid "\"INSTRUMENTS OF DESTRUCTION\""
msgstr ""

#. comic195 panel p1
#. slot: narration (if any, else cut)
#. images: raddback2.gif
#: kidradd/comic195.htm:72
msgctxt "comic195#p1.1"
msgid "You have wet your pants, no?"
msgstr ""

#. comic195 panel p1
#. slot: middle bubble
#. images: raddback2.gif
#: kidradd/comic195.htm:80
msgctxt "comic195#p1.2"
msgid "You brought a boss battle into a spreadsheet program? Have you flipped?"
msgstr ""

#. comic195 panel p2
#. slot: right bubble
#. images: kobatable.gif
#: kidradd/comic195.htm:138
msgctxt "comic195#p2.1"
msgid "I'm not sensing proper respect from you. I went to quite the trouble to prepare a suitable death for a warrior like yourself. Check out all the nifty features."
msgstr ""

#. comic195 panel p3
#. slot: right bubble
#. images: crusher.gif, lasers.gif
#: kidradd/comic195.htm:190
msgctxt "comic195#p3.1"
msgid "Not one, not two, but three spiked platforms will raise and lower themselves in an effort to crush you."
msgstr ""

#. comic195 panel p3
#. slot: imsert images on this line
#. images: crusher.gif, lasers.gif
#: kidradd/comic195.htm:199
msgctxt "comic195#p3.2"
msgid "Homing sensors will fire lasers at you at steady intervals."
msgstr ""

#. comic195 panel p4
#. slot: middle bubble
#. images: sensor.gif
#: kidradd/comic195.htm:240
msgctxt "comic195#p4.1"
msgid "And then there's the, uh... the flashing light thingy. It does nothing. Well, except to blow the machine up. I guess you can shoot at it, but I'd prefer that you didn't."
msgstr ""

#. comic195 panel p5
#. slot: narration (if any, else cut)
#. images: raddback2.gif
#: kidradd/comic195.htm:288
msgctxt "comic195#p5.1"
msgid "Now you are in terror, no?"
msgstr ""

#. comic195 panel p5
#. slot: middle bubble
#. images: raddback2.gif
#: kidradd/comic195.htm:296
msgctxt "comic195#p5.2"
msgid "Gimme a sec, I'm getting there."
msgstr ""

#. comic196 panel title
#. slot: background color and image
#: kidradd/comic196.htm:34
msgctxt "comic196#title.1"
msgid "\"ASK ME NO QUESTIONS\""
msgstr ""

#. comic196 panel p1
#. slot: narration (if any, else cut)
#. images: raddback2.gif
#: kidradd/comic196.htm:71
msgctxt "comic196#p1.1"
msgid "I shall enjoy watching you die."
msgstr ""

#. comic196 panel p1
#. slot: middle bubble
#. images: raddback2.gif
#: kidradd/comic196.htm:79
msgctxt "comic196#p1.2"
msgid "I don't get it. Do you want me to beat you?"
msgstr ""

#. comic196 panel p2
#. slot: right bubble
#. images: kobatable.gif
#: kidradd/comic196.htm:137
msgctxt "comic196#p2.1"
msgid "What? I, the great Kobayashi, discount ninja, have every intent of destroying you! How dare you make such an accusation?"
msgstr ""

#. comic196 panel p3
#. slot: right bubble
#. images: raddright.gif, platform.gif
#: kidradd/comic196.htm:189
msgctxt "comic196#p3.1"
msgid "Well, these convenient platforms serve no purpose other than to help me reach the flashing light. I mean really, just take them away and I could never jump high enough to reach the target."
msgstr ""

#. comic196 panel p3
#. slot: imsert images on this line
#. images: raddright.gif, platform.gif
#: kidradd/comic196.htm:196
msgctxt "comic196#p3.2"
msgid "When Radd gets eloquent, his font gets all tiny."
msgstr ""

#. comic196 panel p5
#. slot: narration (if any, else cut)
#. images: raddblink.gif
#: kidradd/comic196.htm:289
msgctxt "comic196#p5.1"
msgid "They, uh, balance the chains."
msgstr ""

#. comic196 panel p5
#. slot: middle bubble
#. images: raddblink.gif
#: kidradd/comic196.htm:297
msgctxt "comic196#p5.2"
msgid "Whatever. Start the damn thing already."
msgstr ""

#. comic197 panel title
#. slot: background color and image
#: kidradd/comic197.htm:48
msgctxt "comic197#title.1"
msgid "\"DON'T ASK, AGAIN\""
msgstr ""

#. comic197 panel p1
#. slot: narration (if any, else cut)
#: kidradd/comic197.htm:85
msgctxt "comic197#p1.1"
msgid "The battle begins."
msgstr ""

#. comic197 panel p1
#. slot: imsert images on this line
#: kidradd/comic197.htm:91
msgctxt "comic197#p1.2"
msgid "Gah! These things are dangerous. I'd better take 'em out before going after the main target."
msgstr ""

#. comic197 panel p1
#. slot: insert ground "tiles" on this line
#: kidradd/comic197.htm:93
msgctxt "comic197#p1.3"
msgid "Does this panel look off-center?"
msgstr ""

#. comic197 panel p2
#. slot: right bubble
#. images: kobatable.gif
#: kidradd/comic197.htm:140
msgctxt "comic197#p2.1"
msgid "Fool! My traps are protected with an indestructible alloy! I shall laugh as your pathetic attacks bounce off with a cutesy \"clink\" sound! Mwa ha and ha!"
msgstr ""

#. comic197 panel p3
#. slot: middle bubble
#. images: rheadmad.gif
#: kidradd/comic197.htm:190
msgctxt "comic197#p3.1"
msgid "Hey genius, if you've got this indestructible metal or whatever, why didn't you protect your stupid flashing light with it?"
msgstr ""

#. comic197 panel p5
#. slot: narration (if any, else cut)
#. images: raddback2.gif
#: kidradd/comic197.htm:292
msgctxt "comic197#p5.1"
msgid "Uh, the bulb would overheat?"
msgstr ""

#. comic197 panel p5
#. slot: middle bubble
#. images: raddback2.gif
#: kidradd/comic197.htm:300
msgctxt "comic197#p5.2"
msgid "Dude, you've got such a Wily complex."
msgstr ""

#. comic198 panel title
#. slot: background color and image
#: kidradd/comic198.htm:34
msgctxt "comic198#title.1"
msgid "\"TEENAGE WASTELAND\""
msgstr ""

#. comic198 panel p1
#. slot: right bubble
#. images: kobatable.gif
#: kidradd/comic198.htm:79
msgctxt "comic198#p1.1"
msgid "Go, Deathbot! Crush 'im! Zap 'im! And etcetera."
msgstr ""

#. comic198 panel p2
#. slot: middle bubble
#. images: laserdodge.gif
#: kidradd/comic198.htm:132
msgctxt "comic198#p2.1"
msgid "Well, looks like my life is in danger once again. This is only the second time I've had to depend on the skills my player taught me."
msgstr ""

#. comic198 panel p2
#. slot: insert ground "tiles" on this line
#. images: laserdodge.gif
#: kidradd/comic198.htm:143
msgctxt "comic198#p2.2"
msgid "Q: If he's fighting a 2d boss, why's he running in 3d?<br>A: Because it looks cool."
msgstr ""

#. comic198 panel p3
#. slot: middle bubble
#. images: rheadmad.gif
#: kidradd/comic198.htm:184
msgctxt "comic198#p3.1"
msgid "But you taught me well, old master. I prove to you now: The hours you spent with me were not wasted."
msgstr ""

#. comic199 panel title
#. slot: background color and image
#: kidradd/comic199.htm:48
msgctxt "comic199#title.1"
msgid "\"NEW ATTITUDE\""
msgstr ""

#. comic199 panel p1
#. slot: narration (if any, else cut)
#. images: charge.gif, platform2.gif
#: kidradd/comic199.htm:85
msgctxt "comic199#p1.1"
msgid "And so, inevitably..."
msgstr ""

#. comic199 panel p1
#. slot: middle bubble
#. images: charge.gif, platform2.gif
#: kidradd/comic199.htm:93
msgctxt "comic199#p1.2"
msgid "Say goodbye!"
msgstr ""

#. comic199 panel p3
#. slot: left bubble
#. images: kobacry.gif, raddleft.gif
#: kidradd/comic199.htm:178
msgctxt "comic199#p3.1"
msgid "NO!!! Yet another of my ingenius creations has failed me! WHY???"
msgstr ""

#. comic199 panel p4
#. slot: left bubble
#. images: kobaoh.gif, raddstand2.gif
#: kidradd/comic199.htm:230
msgctxt "comic199#p4.1"
msgid "I know! Next time I'll have <b>TWO</b> flashing lights!"
msgstr ""

#. comic199 panel p4
#. slot: right bubble
#. images: kobaoh.gif, raddstand2.gif
#: kidradd/comic199.htm:234
msgctxt "comic199#p4.2"
msgid "Um..."
msgstr ""

#. comic199 panel p5
#. slot: left bubble
#. images: kobayes.gif, raddsigh2.gif
#: kidradd/comic199.htm:284
msgctxt "comic199#p5.1"
msgid "And <b>MOVING</b> platforms! Three of 'em!"
msgstr ""

#. comic199 panel p5
#. slot: right bubble
#. images: kobayes.gif, raddsigh2.gif
#: kidradd/comic199.htm:288
msgctxt "comic199#p5.2"
msgid "Yeah. You do that."
msgstr ""

#. comic200 panel title
#. slot: background color and image
#: kidradd/comic200.htm:34
msgctxt "comic200#title.1"
msgid "\"NO DOUBT\""
msgstr ""

#. comic200 panel p1
#. slot: left bubble
#. images: kobakneel.gif, raddwalk.gif
#: kidradd/comic200.htm:75
msgctxt "comic200#p1.1"
msgid "Hey, where are you going?"
msgstr ""

#. comic200 panel p1
#. slot: right bubble
#. images: kobakneel.gif, raddwalk.gif
#: kidradd/comic200.htm:79
msgctxt "comic200#p1.2"
msgid "Home. Thanks for letting me out."
msgstr ""

#. comic200 panel p2
#. slot: left bubble
#. images: kobastand.gif, raddleft.gif
#: kidradd/comic200.htm:130
msgctxt "comic200#p2.1"
msgid "I don't think so. I was paid to be your assassin, and my task is yet incomplete."
msgstr ""

#. comic200 panel p2
#. slot: right bubble
#. images: kobastand.gif, raddleft.gif
#: kidradd/comic200.htm:134
msgctxt "comic200#p2.2"
msgid "But I wrecked your stupid toys. You lost."
msgstr ""

#. comic200 panel p3
#. slot: right bubble
#. images: koba.gif
#: kidradd/comic200.htm:187
msgctxt "comic200#p3.1"
msgid "Fool! I am a <b>ninja!</b> Gadgetry is merely my hobby; I am perfectly capable of destroying you with my own hands."
msgstr ""

#. comic200 panel p4
#. slot: left bubble
#. images: koba.gif, rlaugh.gif
#: kidradd/comic200.htm:235
msgctxt "comic200#p4.1"
msgid "I'm sensing some doubt on your part."
msgstr ""

#. comic201 panel title
#. slot: background color and image
#: kidradd/comic201.htm:48
msgctxt "comic201#title.1"
msgid "\"LIGHTSPEED\""
msgstr ""

#. comic201 panel p1
#. slot: left bubble
#. images: koba.gif, raddleft.gif
#: kidradd/comic201.htm:89
msgctxt "comic201#p1.1"
msgid "Now I shall finish my job, and avenge my poor Deathbot."
msgstr ""

#. comic201 panel p1
#. slot: right bubble
#. images: koba.gif, raddleft.gif
#: kidradd/comic201.htm:93
msgctxt "comic201#p1.2"
msgid "Whatever."
msgstr ""

#. comic201 panel p2
#. slot: insert ground "tiles" on this line
#: kidradd/comic201.htm:159
msgctxt "comic201#p2.1"
msgid "Whoosh!"
msgstr ""

#. comic201 panel p3
#. slot: left bubble
#. images: raddleft.gif, koba.gif
#: kidradd/comic201.htm:198
msgctxt "comic201#p3.1"
msgid "You missed."
msgstr ""

#. comic201 panel p3
#. slot: right bubble
#. images: raddleft.gif, koba.gif
#: kidradd/comic201.htm:202
msgctxt "comic201#p3.2"
msgid "Heh heh. Did I?"
msgstr ""

#. comic201 panel p4
#. slot: left bubble
#. images: raddstand.gif, koba2.gif
#: kidradd/comic201.htm:250
msgctxt "comic201#p4.1"
msgid "Yes. Badly."
msgstr ""

#. comic201 panel p4
#. slot: right bubble
#. images: raddstand.gif, koba2.gif
#: kidradd/comic201.htm:254
msgctxt "comic201#p4.2"
msgid "<b>DAMMIT!</b> And I've been practicing, too!"
msgstr ""

#. comic202 panel title
#. slot: background color and image
#: kidradd/comic202.htm:48
msgctxt "comic202#title.1"
msgid "\"WHY HE'S A 'DISCOUNT' NINJA\""
msgstr ""

#. comic202 panel p1
#. slot: left bubble
#. images: raddstand.gif, koba2.gif
#: kidradd/comic202.htm:89
msgctxt "comic202#p1.1"
msgid "Is that the full extent of your skills?"
msgstr ""

#. comic202 panel p1
#. slot: right bubble
#. images: raddstand.gif, koba2.gif
#: kidradd/comic202.htm:93
msgctxt "comic202#p1.2"
msgid "You got lucky that time, but now you will not survive!"
msgstr ""

#. comic202 panel p2
#. slot: insert ground "tiles" on this line
#: kidradd/comic202.htm:159
msgctxt "comic202#p2.1"
msgid "Whoosh!"
msgstr ""

#. comic202 panel p3
#. slot: left bubble
#. images: raddleft.gif, koba.gif
#: kidradd/comic202.htm:198
msgctxt "comic202#p3.1"
msgid "Sorry, nothing."
msgstr ""

#. comic202 panel p3
#. slot: right bubble
#. images: raddleft.gif, koba.gif
#: kidradd/comic202.htm:202
msgctxt "comic202#p3.2"
msgid "What???"
msgstr ""

#. comic202 panel p4
#. slot: left bubble
#. images: raddstand.gif, kobacry2.gif
#: kidradd/comic202.htm:250
msgctxt "comic202#p4.1"
msgid "Dude, your aim <b>really</b> sucks."
msgstr ""

#. comic202 panel p4
#. slot: right bubble
#. images: raddstand.gif, kobacry2.gif
#: kidradd/comic202.htm:254
msgctxt "comic202#p4.2"
msgid "I'm from a 2D game, alright?"
msgstr ""

#. comic203 panel title
#. slot: background color and image
#: kidradd/comic203.htm:34
msgctxt "comic203#title.1"
msgid "\"STAY ON THE SUNNY SIDE\""
msgstr ""

#. comic203 panel p1
#. slot: left bubble
#. images: raddstand.gif, koba2.gif
#: kidradd/comic203.htm:75
msgctxt "comic203#p1.1"
msgid "Why are you even trying to kill me?"
msgstr ""

#. comic203 panel p1
#. slot: right bubble
#. images: raddstand.gif, koba2.gif
#: kidradd/comic203.htm:79
msgctxt "comic203#p1.2"
msgid "Nothing personal, it's just my job, my current assignment."
msgstr ""

#. comic203 panel p2
#. slot: left bubble
#. images: raddblink.gif, koba2.gif
#: kidradd/comic203.htm:132
msgctxt "comic203#p2.1"
msgid "You're a cold-blooded killer, huh?"
msgstr ""

#. comic203 panel p2
#. slot: right bubble
#. images: raddblink.gif, koba2.gif
#: kidradd/comic203.htm:136
msgctxt "comic203#p2.2"
msgid "Well, sort of..."
msgstr ""

#. comic203 panel p3
#. slot: left bubble
#. images: raddstand.gif, koba2.gif
#: kidradd/comic203.htm:184
msgctxt "comic203#p3.1"
msgid "Just how many people have you killed?"
msgstr ""

#. comic203 panel p3
#. slot: right bubble
#. images: raddstand.gif, koba2.gif
#: kidradd/comic203.htm:188
msgctxt "comic203#p3.2"
msgid "Er... one half?"
msgstr ""

#. comic203 panel p4
#. slot: left bubble
#. images: raddsigh.gif, koba2.gif
#: kidradd/comic203.htm:236
