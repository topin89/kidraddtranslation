#. comic212 panel title
#. slot: background color and image
#: kidradd/comic212.htm:34
msgctxt "comic212#title.1"
msgid "\"REBEL WITHOUT A CLUE\""
msgstr ""

#. comic212 panel p1
#. slot: left bubble
#. images: ship.gif
#: kidradd/comic212.htm:75
msgctxt "comic212#p1.1"
msgid "So where are we going?"
msgstr ""

#. comic212 panel p1
#. slot: middle bubble
#. images: ship.gif
#: kidradd/comic212.htm:77
