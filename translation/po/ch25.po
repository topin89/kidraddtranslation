#. comic469 panel p4
#. slot: middle bubble
#. images: momenu.gif
#: kidradd/comic469.htm:261
msgctxt "comic469#p4.2"
msgid "Yes Radd, we are."
msgstr ""

#. comic469 panel p4
#. slot: right bubble
#. images: momenu.gif
#: kidradd/comic469.htm:263
msgctxt "comic469#p4.3"
msgid "I beg to differ, heh heh..."
