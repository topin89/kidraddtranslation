#: kidradd/comic466.htm:34
msgctxt "comic466#title.1"
msgid "<font color=\"ffffff\" face=\"arial\" size=\"2\"><b>&copy;199X SIMIAN SOFTWARE<br>Press Start</b></font><br><br><font color=\"ffffff\" class=\"rundschrift\" face=\"VAG Rundschrift D, arial\" size=\"3\">\"NEVER LEARN\"</font>"
