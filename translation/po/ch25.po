msgid "\"Battle 001: Begin!\""
msgstr ""

#. comic468 panel p2
#. slot: left bubble
#. images: bappear.gif, momenu.gif
#: kidradd/comic468.htm:150
msgctxt "comic468#p2.1"
msgid "Far out! This system rocks!"
msgstr ""

#. comic468 panel p2
#. slot: middle bubble
#. images: bappear.gif, momenu.gif
#: kidradd/comic468.htm:152
msgctxt "comic468#p2.2"
msgid "Dig it."
msgstr ""

#. comic468 panel p2
#. slot: right bubble
#. images: bappear.gif, momenu.gif
#: kidradd/comic468.htm:154
msgctxt "comic468#p2.3"
msgid "Is this a battle screen or a disco?"
msgstr ""

#. comic468 panel p3
#. slot: left bubble
#. images: bunny.gif, momenu.gif
#: kidradd/comic468.htm:202
msgctxt "comic468#p3.1"
msgid "Uh, where are you guys? I can't see you. ...Or me!"
msgstr ""

#. comic468 panel p3
#. slot: middle bubble
#. images: bunny.gif, momenu.gif
#: kidradd/comic468.htm:204
msgctxt "comic468#p3.2"
msgid "Trippy."
msgstr ""

#. comic468 panel p3
#. slot: right bubble
#. images: bunny.gif, momenu.gif
#: kidradd/comic468.htm:206
msgctxt "comic468#p3.3"
msgid "Pay attention, troops."
msgstr ""

#. comic468 panel p4
#. slot: left bubble
#. images: momenu.gif
#: kidradd/comic468.htm:255
msgctxt "comic468#p4.1"
msgid "Yikes! It can do that?"
msgstr ""

#. comic468 panel p4
#. slot: middle bubble
#. images: momenu.gif
#: kidradd/comic468.htm:257
msgctxt "comic468#p4.2"
msgid "What's weirder is that it does it <i>alone.</i>"
msgstr ""

#. comic468 panel p4
#. slot: right bubble
#. images: momenu.gif
#: kidradd/comic468.htm:259
msgctxt "comic468#p4.3"
msgid "Must be unicellular."
msgstr ""

