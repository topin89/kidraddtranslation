msgid "<font color=\"ffffff\" face=\"arial\" size=\"2\"><b>&copy;199X SIMIAN SOFTWARE<br>Press Start</b></font><br><br><font color=\"ffffff\" class=\"rundschrift\" face=\"VAG Rundschrift D, arial\" size=\"3\">\"RUTHLESS\"</font>"
msgstr ""

#. comic467 panel p1
#. slot: narration (if any, else cut)
#. images: raddsigh.gif, ibmad2.gif, giguy.gif
#: kidradd/comic467.htm:71
msgctxt "comic467#p1.1"
msgid "Fifteen minutes later..."
msgstr ""

#. comic467 panel p1
#. slot: left bubble
#. images: raddsigh.gif, ibmad2.gif, giguy.gif
#: kidradd/comic467.htm:77
msgctxt "comic467#p1.2"
msgid "No pizza..."
msgstr ""

#. comic467 panel p1
#. slot: right bubble
#. images: raddsigh.gif, ibmad2.gif, giguy.gif
#: kidradd/comic467.htm:81
msgctxt "comic467#p1.3"
msgid "Geez, Radd. How many times do I have to explain, you <i>got</i> the friggin' pizza!"
msgstr ""

#. comic467 panel p2
#. slot: left bubble
#. images: raddstand.gif, ib2.gif, giguy.gif
#: kidradd/comic467.htm:133
msgctxt "comic467#p2.1"
msgid "But I never saw any -"
msgstr ""

#. comic467 panel p2
#. slot: right bubble
#. images: raddstand.gif, ib2.gif, giguy.gif
#: kidradd/comic467.htm:137
msgctxt "comic467#p2.2"
msgid "It's an RPG! You won't see most of the power-ups, cuz they don't have graphics. You'll just read some \"Radd ate the Burger\" text and then poof, your HP max out."
msgstr ""

#. comic467 panel p3
#. slot: left bubble
#. images: raddwalk.gif, ibwalk.gif, giwalk.gif
#: kidradd/comic467.htm:186
msgctxt "comic467#p3.1"
msgid "What a rip-off. So flavorless..."
msgstr ""

#. comic467 panel p3
#. slot: right bubble
#. images: raddwalk.gif, ibwalk.gif, giwalk.gif
#: kidradd/comic467.htm:190
msgctxt "comic467#p3.2"
msgid "We're wasting time. Let's trigger a battle, just so we can see what kind of system we're up against."
msgstr ""

#. comic467 panel p4
#. slot: left bubble
#. images: raddstand.gif, ibpoint.gif, giflame.gif, bgraze.gif
#: kidradd/comic467.htm:240
msgctxt "comic467#p4.1"
msgid "Agreed. And look, right on cue..."
msgstr ""

#. comic467 panel p4
#. slot: right bubble
