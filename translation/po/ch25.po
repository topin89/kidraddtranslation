msgid "<font color=\"ffffff\" face=\"arial\" size=\"2\"><b>&copy;199X SIMIAN SOFTWARE<br>Press Start</b></font><br><br><font color=\"ffffff\" class=\"rundschrift\" face=\"VAG Rundschrift D, arial\" size=\"3\">\"BOOBY PRIZE\"</font>"
msgstr ""

#. comic493 panel p1
#. slot: left bubble
#: kidradd/comic493.htm:97
msgctxt "comic493#p1.1"
msgid "Where are we?"
msgstr ""

#. comic493 panel p1
#. slot: right bubble
#: kidradd/comic493.htm:101
msgctxt "comic493#p1.2"
msgid "Did the game freeze up?"
msgstr ""

#. comic493 panel p2
#. slot: left bubble
#: kidradd/comic493.htm:153
msgctxt "comic493#p2.1"
msgid "Uh..."
msgstr ""

#. comic493 panel p2
#. slot: right bubble
#: kidradd/comic493.htm:157
msgctxt "comic493#p2.2"
msgid "What the-?"
msgstr ""

#. comic493 panel p3
#. slot: middle bubble
#. images: moangel.gif, raddback.gif, ibback.gif, elback2.gif, giback2.gif
#: kidradd/comic493.htm:207
msgctxt "comic493#p3.1"
msgid "\"If you're here, it means you probably cheated. Naughty, naughty!\""
msgstr ""

#. comic493 panel p3
#. slot: middle bubble
#. images: moangel.gif, raddback.gif, ibback.gif, elback2.gif, giback2.gif
#: kidradd/comic493.htm:232
msgctxt "comic493#p3.2"
msgid "Cute. I guess this is an easter egg of sorts."
msgstr ""

#. comic493 panel p4
#. slot: middle bubble
#. images: moangelm.gif, raddback.gif, ibback.gif, elback2.gif, giback2.gif
#: kidradd/comic493.htm:277
msgctxt "comic493#p4.1"
msgid "\"You used one of those evil Game Wizard systems, didn't you? <b>EVIL!</b>\""
msgstr ""

#. comic493 panel p4
#. slot: left bubble
#. images: moangelm.gif, raddback.gif, ibback.gif, elback2.gif, giback2.gif
#: kidradd/comic493.htm:300
msgctxt "comic493#p4.2"
msgid "The egg has some issues."
msgstr ""

#. comic493 panel p4
#. slot: right bubble
#. images: moangelm.gif, raddback.gif, ibback.gif, elback2.gif, giback2.gif
#: kidradd/comic493.htm:304
msgctxt "comic493#p4.3"
msgid "I think I like it."
msgstr ""

#. comic494 panel title
#. slot: background color and image
#. images: mlogo.gif
#: kidradd/comic494.htm:47
msgctxt "comic494#title.1"
msgid "<font color=\"ffffff\" face=\"arial\" size=\"2\"><b>&copy;199X SIMIAN SOFTWARE<br>Press Start</b></font><br><br><font color=\"ffffff\" class=\"rundschrift\" face=\"VAG Rundschrift D, arial\" size=\"3\">\"SIGNED, SEALED, DELIVERED\"</font>"
msgstr ""

#. comic494 panel p1
#. slot: left bubble
#. images: bogeystand.gif, nursetalk.gif, sheenaright.gif, ampstand.gif, moangel.gif
#: kidradd/comic494.htm:88
msgctxt "comic494#p1.1"
msgid "So, the mission is a failure?..."
msgstr ""

#. comic494 panel p1
#. slot: right bubble
#. images: bogeystand.gif, nursetalk.gif, sheenaright.gif, ampstand.gif, moangel.gif
#: kidradd/comic494.htm:92
msgctxt "comic494#p1.2"
msgid "\"Sorry Sheena, the boss wasn't all he was cracked up to be.\""
msgstr ""

#. comic494 panel p1
#. slot: insert ground "tiles" on this line
#. images: bogeystand.gif, nursetalk.gif, sheenaright.gif, ampstand.gif, moangel.gif
#: kidradd/comic494.htm:101
msgctxt "comic494#p1.3"
msgid "\"Today's lesson is about the importance of the Seveightgo Seal of Approval.\""
msgstr ""

#. comic494 panel p2
#. slot: left bubble
#. images: raddstare.gif, elhappy.gif, ibleft.gif, giback.gif, moangel.gif
#: kidradd/comic494.htm:144
msgctxt "comic494#p2.1"
msgid "Eliot's gonna Transport us back to the start of the game so you can get us out."
msgstr ""

#. comic494 panel p2
#. slot: right bubble
#. images: raddstare.gif, elhappy.gif, ibleft.gif, giback.gif, moangel.gif
#: kidradd/comic494.htm:148
msgctxt "comic494#p2.2"
msgid "Wait, I think he's trying to tell us something."
msgstr ""

#. comic494 panel p2
#. slot: insert ground "tiles" on this line
#. images: raddstare.gif, elhappy.gif, ibleft.gif, giback.gif, moangel.gif
#: kidradd/comic494.htm:159
msgctxt "comic494#p2.3"
msgid "\"For quality assurance, you should buy only products that carry the Seveightgo Seal.\""
msgstr ""

#. comic494 panel p3
#. slot: imsert images on this line
#. images: moangel.gif
#: kidradd/comic494.htm:210
msgctxt "comic494#p3.1"
msgid "<b>Translation:</b><br>Thanks to your help I have finally been everywhere and seen everything this game has to show me. I now yearn for a new challenge. Please, take me with you on your journey!"
msgstr ""

#. comic494 panel p3
#. slot: insert ground "tiles" on this line
#. images: moangel.gif
#: kidradd/comic494.htm:213
msgctxt "comic494#p3.2"
msgid "\"Products carrying the Seal are inherently better. Why? Because they give us a cut of the profits.\""
msgstr ""

#. comic494 panel p4
#. slot: left bubble
#. images: raddblink.gif, elfront2.gif, ib2.gif, giright.gif, moangelm.gif
#: kidradd/comic494.htm:253
msgctxt "comic494#p4.1"
msgid "How cute, he's hungry! Give 'im another Cookie, IB!"
msgstr ""

#. comic494 panel p4
#. slot: right bubble
#. images: raddblink.gif, elfront2.gif, ib2.gif, giright.gif, moangelm.gif
#: kidradd/comic494.htm:257
msgctxt "comic494#p4.2"
msgid "You're truly the master of intuition, kid."
msgstr ""

#. comic494 panel p4
#. slot: insert ground "tiles" on this line
#. images: raddblink.gif, elfront2.gif, ib2.gif, giright.gif, moangelm.gif
#: kidradd/comic494.htm:268
msgctxt "comic494#p4.3"
msgid "\"So look for the Seal. Trust us, it's for your own... protection.\""
msgstr ""

#. comic495 panel title
#. slot: background color and image
#: kidradd/comic495.htm:54
msgctxt "comic495#title.1"
msgid "\"IT'S CALLED 'IRONY'\""
msgstr ""

#. comic495 panel p1
#. slot: narration (if any, else cut)
#. images: scrowd2.gif
#: kidradd/comic495.htm:91
msgctxt "comic495#p1.1"
msgid "And so, little Eliot joins the ship's crew."
msgstr ""

#. comic495 panel p1
#. slot: left bubble
#. images: scrowd2.gif
#: kidradd/comic495.htm:97
msgctxt "comic495#p1.2"
msgid "Well folks, it's been a long day but thankfully we're all back together, alive and in one piece."
msgstr ""

#. comic495 panel p2
#. slot: left bubble
#. images: btw.gif
#: kidradd/comic495.htm:153
msgctxt "comic495#p2.1"
msgid "By the way Sheena, didn't you have something you wanted to say to me?"
msgstr ""

#. comic495 panel p2
#. slot: right bubble
#. images: btw.gif
#: kidradd/comic495.htm:157
msgctxt "comic495#p2.2"
msgid "Oh, yes. I don't think words can express it properly."
msgstr ""

#. comic495 panel p4
#. slot: narration (if any, else cut)
#: kidradd/comic495.htm:257
msgctxt "comic495#p4.1"
msgid "Just then, Sheena's double has a revelation."
msgstr ""

#. comic495 panel p4
#. slot: middle bubble
#: kidradd/comic495.htm:265
msgctxt "comic495#p4.2"
msgid "You know, I never noticed how <b>adorable</b> he was before!"
msgstr ""

#. comic495 panel p5
#. slot: left bubble
#. images: 2love.gif
#: kidradd/comic495.htm:315
msgctxt "comic495#p5.1"
msgid "I think I'm falling in love!"
msgstr ""

#. comic495 panel p5
#. slot: right bubble
#. images: 2love.gif
#: kidradd/comic495.htm:319
msgctxt "comic495#p5.2"
msgid "At least one of us is."
msgstr ""
