#. images: ibmad.gif, raddmad2.gif, gisigh.gif, lavalamp.gif
#: kidradd/comic466.htm:71
msgctxt "comic466#p1.1"
msgid "\"Are you guys okay in there?\""
msgstr ""

#. comic466 panel p1
#. slot: left bubble
#. images: ibmad.gif, raddmad2.gif, gisigh.gif, lavalamp.gif
#: kidradd/comic466.htm:77
msgctxt "comic466#p1.2"
msgid "Yes, Dr. Amp..."
msgstr ""

#. comic466 panel p2
#. slot: narration (if any, else cut)
#. images: ib.gif, giguy.gif, raddright.gif, granny2.gif
#: kidradd/comic466.htm:129
msgctxt "comic466#p2.1"
msgid "\"Good. Then you've started your journey forward?\""
msgstr ""

#. comic466 panel p2
#. slot: left bubble
#. images: ib.gif, giguy.gif, raddright.gif, granny2.gif
#: kidradd/comic466.htm:135
msgctxt "comic466#p2.2"
msgid "Not quite..."
msgstr ""

#. comic466 panel p2
#. slot: right bubble
#. images: ib.gif, giguy.gif, raddright.gif, granny2.gif
#: kidradd/comic466.htm:139
msgctxt "comic466#p2.3"
msgid "\"Good morning sonny! Do you feel rested now?\""
msgstr ""

#. comic466 panel p3
#. slot: narration (if any, else cut)
#. images: ib.gif, giguy.gif, granny.gif, raddblink2.gif
#: kidradd/comic466.htm:184
msgctxt "comic466#p3.1"
msgid "\"Why not? Is something wrong?\""
msgstr ""

#. comic466 panel p3
#. slot: left bubble
#. images: ib.gif, giguy.gif, granny.gif, raddblink2.gif
#: kidradd/comic466.htm:190
msgctxt "comic466#p3.2"
msgid "Well..."
msgstr ""

#. comic466 panel p3
#. slot: middle bubble
#. images: ib.gif, giguy.gif, granny.gif, raddblink2.gif
#: kidradd/comic466.htm:192
msgctxt "comic466#p3.3"
msgid "Want PIZZA?"
msgstr ""

#. comic466 panel p3
#. slot: right bubble
#. images: ib.gif, giguy.gif, granny.gif, raddblink2.gif
#: kidradd/comic466.htm:194
msgctxt "comic466#p3.4"
msgid "Sure!"
msgstr ""

#. comic466 panel p4
#. slot: left bubble
#. images: ibmad.gif, raddmad2.gif, gisigh.gif, lavalamp.gif
#: kidradd/comic466.htm:243
msgctxt "comic466#p4.1"
msgid "For crying out loud, Radd! <b>Stop saying \"yes!\"</b>"
msgstr ""

#. comic466 panel p4
#. slot: middle bubble
#. images: ibmad.gif, raddmad2.gif, gisigh.gif, lavalamp.gif
#: kidradd/comic466.htm:245
msgctxt "comic466#p4.2"
msgid "Not until I get that pizza!"
msgstr ""

#. comic466 panel p4
#. slot: right bubble
#. images: ibmad.gif, raddmad2.gif, gisigh.gif, lavalamp.gif
#: kidradd/comic466.htm:247
msgctxt "comic466#p4.3"
msgid "The stupidity... It hurts..."
msgstr ""

