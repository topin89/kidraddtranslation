#. comic469 panel p3
#. slot: right bubble
#. images: momenu.gif
#: kidradd/comic469.htm:210
msgctxt "comic469#p3.3"
msgid "Clever."
msgstr ""

#. comic469 panel p4
#. slot: left bubble
#. images: momenu.gif
#: kidradd/comic469.htm:259
