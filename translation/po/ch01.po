#. slot: narration (if any, else cut)
#. images: raddrun.gif, floor2run.gif
#: kidradd/comic3.htm:91
#, fuzzy
msgctxt "comic3#p1.1"
msgid "Radd is under complete control of the player."
msgstr "Улёт полностью подчиняется игроку."

#. comic3 panel p1
#. slot: middle bubble
#. images: raddrun.gif, floor2run.gif
#: kidradd/comic3.htm:99
#, fuzzy
msgctxt "comic3#p1.2"
