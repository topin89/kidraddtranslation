#. slot: middle bubble
#. images: raddstare.gif, floor2.gif
#: kidradd/comic1.htm:115
#, fuzzy
msgctxt "comic1#p2.2"
msgid "Hey."
msgstr "Привет."

#. comic1 panel p3
#. slot: narration (if any, else cut)
#. images: raddstare.gif, floor2.gif
#: kidradd/comic1.htm:162
#, fuzzy
msgctxt "comic1#p3.1"
