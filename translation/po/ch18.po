#. comic324 panel title
#. slot: background color and image
#: kidradd/comic324.htm:53
msgctxt "comic324#title.1"
msgid "\"FORBODING\""
msgstr ""

#. comic324 panel p1
#. slot: left bubble
#: kidradd/comic324.htm:94
msgctxt "comic324#p1.1"
msgid "Go, Bogey!"
msgstr ""

#. comic324 panel p2
#. slot: left bubble
#. images: sheenaback.gif, raddstare.gif, bogeydown2.gif, hero2.gif
#: kidradd/comic324.htm:151
msgctxt "comic324#p2.1"
