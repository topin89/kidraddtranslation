#. comic322 panel p3
#. slot: middle bubble
#. images: sheenaback.gif, charge.gif, bogeylook.gif
#: kidradd/comic322.htm:265
msgctxt "comic322#p3.2"
msgid "Radd, you dummy..."
msgstr ""

#. comic322 panel p4
#. slot: right bubble
#. images: sheenamad.gif, bogeysneer.gif, hero2.gif
#: kidradd/comic322.htm:312
msgctxt "comic322#p4.1"
msgid "What a stupid enemy."
msgstr ""

#. comic322 panel p4
#. slot: middle bubble
#. images: sheenamad.gif, bogeysneer.gif, hero2.gif
#: kidradd/comic322.htm:335
msgctxt "comic322#p4.2"
msgid "You're telling me?"
msgstr ""

#. comic323 panel title
#. slot: background color and image
#: kidradd/comic323.htm:61
msgctxt "comic323#title.1"
msgid "\"DO WHAT YOU DO\""
msgstr ""

#. comic323 panel p1
#. slot: left bubble
#: kidradd/comic323.htm:102
msgctxt "comic323#p1.1"
msgid "Alright fools, taste my blade!"
msgstr ""

#. comic323 panel p2
#. slot: left bubble
#. images: sheenaback.gif, raddmad.gif, bogeysigh.gif, hero2.gif
#: kidradd/comic323.htm:159
msgctxt "comic323#p2.1"
msgid "I don't know how you did that from way over there, but it's payback time!"
msgstr ""

#. comic323 panel p2
#. slot: left bubble
#. images: sheenaback.gif, raddmad.gif, bogeysigh.gif, hero2.gif
#: kidradd/comic323.htm:184
msgctxt "comic323#p2.2"
msgid "Er, not quite yet Radd. My turn is next."
msgstr ""

#. comic323 panel p3
#. slot: left bubble
#. images: sheenaright.gif, raddstare.gif, bogeylook.gif
#: kidradd/comic323.htm:228
msgctxt "comic323#p3.1"
msgid "Um, why?"
msgstr ""

#. comic323 panel p3
#. slot: middle bubble
#. images: sheenaright.gif, raddstare.gif, bogeylook.gif
#: kidradd/comic323.htm:255
msgctxt "comic323#p3.2"
