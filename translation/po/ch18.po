#. comic321 panel p4
#. slot: middle bubble
#. images: sheenamad.gif, raddflip.gif, bogeylsigh.gif
#: kidradd/comic321.htm:324
msgctxt "comic321#p4.2"
msgid "What on earth is wrong with you?"
msgstr ""

#. comic322 panel title
#. slot: background color and image
#: kidradd/comic322.htm:53
msgctxt "comic322#title.1"
msgid "\"JUST HAVE TO WAIT\""
msgstr ""

#. comic322 panel p1
#. slot: left bubble
#. images: sheenaback.gif, raddblink2.gif, bogeysigh.gif, hero2.gif
#: kidradd/comic322.htm:94
msgctxt "comic322#p1.1"
msgid "Alright, just kidding. I guess I'll try to \"attack\" now."
msgstr ""

#. comic322 panel p1
#. slot: left bubble
#. images: sheenaback.gif, raddblink2.gif, bogeysigh.gif, hero2.gif
#: kidradd/comic322.htm:119
msgctxt "comic322#p1.2"
msgid "Sorry, but the hero's turn is first."
