#. comic323 panel p5
#. slot: left bubble
#. images: sheenamad.gif, raddstare.gif, bogeysneer.gif, hero2.gif
#: kidradd/comic323.htm:353
msgctxt "comic323#p5.1"
msgid "Was that an attack, or just a general statement?"
msgstr ""

#. comic323 panel p5
#. slot: left bubble
#. images: sheenamad.gif, raddstare.gif, bogeysneer.gif, hero2.gif
#: kidradd/comic323.htm:378
msgctxt "comic323#p5.2"
