#: kidradd/comic320.htm:83
msgctxt "comic320#p1.1"
msgid "Bogey! You're okay?"
msgstr ""

#. comic320 panel p1
#. slot: middle bubble
#. images: sheenastand.gif, raddwow.gif, bogeyno.gif, hero2.gif
#: kidradd/comic320.htm:85
msgctxt "comic320#p1.2"
msgid "I think so..."
msgstr ""

#. comic320 panel p1
#. slot: left bubble
#. images: sheenastand.gif, raddwow.gif, bogeyno.gif, hero2.gif
#: kidradd/comic320.htm:108
msgctxt "comic320#p1.3"
msgid "Yeah, touching the hero just triggered a battle."
msgstr ""

#. comic320 panel p2
#. slot: left bubble
#. images: sheenaback.gif, raddstare.gif, bogeystand.gif, hero2.gif
#: kidradd/comic320.htm:158
msgctxt "comic320#p2.1"
msgid "Hey, how'd we leave the city?"
msgstr ""

#. comic320 panel p2
#. slot: left bubble
#. images: sheenaback.gif, raddstare.gif, bogeystand.gif, hero2.gif
#: kidradd/comic320.htm:183
msgctxt "comic320#p2.2"
msgid "We didn't. This is a battle screen."
msgstr ""

#. comic320 panel p3
#. slot: left bubble
#. images: rheadmad.gif, sheadsad.gif
#: kidradd/comic320.htm:227
msgctxt "comic320#p3.1"
msgid "I seem to be stuck here. How the hell are we supposed to fight at twenty paces apart?"
msgstr ""

#. comic320 panel p3
#. slot: right bubble
#. images: rheadmad.gif, sheadsad.gif
#: kidradd/comic320.htm:231
msgctxt "comic320#p3.2"
msgid "It's... tough to explain. Just go with it."
msgstr ""

#. comic320 panel p4
#. slot: right bubble
#. images: sheenablink.gif, raddmad.gif, bogeysigh.gif, hero2.gif
#: kidradd/comic320.htm:283
msgctxt "comic320#p4.1"
msgid "You guys are talking? Great, I <i>knew</i> this was a scripted battle!"
msgstr ""

#. comic320 panel p4
#. slot: left bubble
#. images: sheenablink.gif, raddmad.gif, bogeysigh.gif, hero2.gif
#: kidradd/comic320.htm:304
msgctxt "comic320#p4.2"
msgid "Don't worry, I'll kick your butt, just as soon as I figure out how."
msgstr ""

#. comic321 panel title
#. slot: background color and image
#: kidradd/comic321.htm:42
msgctxt "comic321#title.1"
msgid "\"CROWDED HOUSE\""
msgstr ""

#. comic321 panel p1
#. slot: left bubble
#. images: sheenastand.gif, raddback.gif, bogeystand.gif, hero2.gif
#: kidradd/comic321.htm:83
msgctxt "comic321#p1.1"
msgid "Man, I really can't seem to move."
msgstr ""

#. comic321 panel p1
#. slot: left bubble
#. images: sheenastand.gif, raddback.gif, bogeystand.gif, hero2.gif
#: kidradd/comic321.htm:108
msgctxt "comic321#p1.2"
