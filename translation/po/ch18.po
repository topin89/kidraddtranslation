#. slot: left bubble
#. images: raddfront.gif, sheenafront2.gif, bogeyyell.gif
#: kidradd/comic316.htm:83
msgctxt "comic316#p1.1"
msgid "Where are we? Something feels bogus here."
msgstr ""

#. comic316 panel p1
#. slot: right bubble
#. images: raddfront.gif, sheenafront2.gif, bogeyyell.gif
#: kidradd/comic316.htm:87
msgctxt "comic316#p1.2"
msgid "Looks like this is an RPG. Probably a sequel to the game Reset's residents came from."
msgstr ""

#. comic316 panel p2
#. slot: left bubble
#. images: raddright.gif, sheenastand2.gif, bogeystand2.gif
#: kidradd/comic316.htm:142
msgctxt "comic316#p2.1"
msgid "Am I lying down?"
