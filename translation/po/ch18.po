msgstr ""

#. comic324 panel p2
#. slot: left bubble
#. images: sheenaback.gif, raddstare.gif, bogeydown2.gif, hero2.gif
#: kidradd/comic324.htm:176
msgctxt "comic324#p2.2"
msgid "Not exactly. Again, it's tough to explain."
msgstr ""

#. comic324 panel p3
#. slot: middle bubble
